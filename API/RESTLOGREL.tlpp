#include "tlpp-core.th"
#include "totvs.ch"

// ============================================================================
// LOGISTICA (LOGREL) - pedidos de entrega para a tela PO UI U_LOGRELAPP
//
// GET /api/v1/vs-financial-data/logistica/pedidos?de=AAAAMMDD&ate=AAAAMMDD
//   Base = item do pedido (SC6) nao eliminado por residuo (C6_BLQ <> 'R') e:
//   a) pedido SEM NOTA (nenhum item com C6_NOTA real): TODOS, de qualquer TES,
//      tipo (C5_TIPO) e emissao - e o "Previstos" da tela, igual aos pedidos
//      em aberto do MATA410 (pedido do usuario, 13/11/2026);
//   b) pedido COM NOTA emitido no periodo (C5_EMISSAO) e: item com TES de
//      SAIDA que MOVIMENTA estoque (F4_TIPO = 'S' e F4_ESTOQUE = 'S') em pedido
//      normal (C5_TIPO = 'N'), OU pedido com data de envio (C5_ZDTENV), de
//      qualquer TES/tipo: o que a logistica registrou aparece (2026-11-13c).
//   TES 610 (remessa para conserto, inicio da operacao) entra como se
//   movimentasse estoque (2026-11-19b, pedido do usuario; LG_TES_INCLUI).
//   Fora sempre: item de REMESSA POR CONTA E ORDEM (CFOP x923 no C6_CF: 5923,
//   6923). E so o documento fiscal; o transporte sai em outro pedido, que e o
//   que a logistica acompanha (pedido do usuario, 13/11/2026, 2026-11-13d).
//
// POST /api/v1/vs-financial-data/logistica/pedidos/busca  {"pedidos": ["000009", ...]}
//   Os pedidos pedidos pelo numero, SEM filtro de TES, tipo, emissao ou residuo
//   (ate 500 por chamada). A importacao da tela usa para achar o que nao veio
//   no GET: a planilha pode trazer qualquer pedido (pedido do usuario, 13/11/2026).
//   Resposta {"versao", "pedidos": [...], "naoEncontrados": [...]}.
//   Pedido de devolucao/beneficiamento (C5_TIPO D/B) e de fornecedor: nome,
//   cidade e UF vem da SA2.
//   Resposta agrupada por pedido (cabecalho SC5 + itens SC6).
//   - Cliente/loja = C5_CLIENTE/C5_LOJACLI (nome e grupo A1_GRPVEN -> ACY_DESCRI);
//     cidade/UF = cliente de ENTREGA (C5_CLIENT/C5_LOJAENT).
//   - Frete destacado = C5_FRETE (numerico); frete nao destacado = C5_ZFRETE
//     (CARACTER): vai o texto original e o valor lido por ValTxt (aceita
//     "1.234,56", "1234.56", "R$ 150,00").
//   - Campos de logistica criados na SC5 em 11/2026 (C5_ZDTENV, C5_ZDTPREV,
//     C5_ZDTENTR, C5_ZTPMAT, C5_ZCTE, C5_ZVLRCTE, C5_ZREENTR, C5_ZCTEREE,
//     C5_ZVCTERE, C5_ZNDENT, C5_ZINDICA) e os opcionais C5_ZTPPEDI, C5_ZFRETE,
//     C5_VOLUME1, C5_ESPECI1, C5_PESOL, C5_PBRUTO: conferidos no ALL_TAB_COLUMNS a cada consulta. Campo que nao
//     existe vira ' ' na query (coluna inexistente derruba a thread do REST sem
//     passar pelo Recover) e sai em "camposFaltando".
//   - Retorno a empresa (2026-11-13e): C5_ZDTRET (data), C5_ZMOTRET (combo:
//     1=Recusa;2=Endereco;3=Avaria;4=Outros) e C5_ZPEDREN (pedido do reenvio).
//     A mercadoria volta e sai de novo em OUTRO pedido; a tela poe o original
//     na coluna Retornados. Opcionais como os outros Z (ALL_TAB_COLUMNS).
//   - "opcoes": combos do SX3 (X3_CBOX) de C5_ZTPMAT, C5_ZINDICA, C5_ZREENTR,
//     C5_ZTPPEDI e C5_ZMOTRET, para a tela nao depender de lista fixa.
//   - "telefone" (cliente de entrega) e "telefoneCliente" (cliente do pedido):
//     A1_DDD + A1_TEL (A2_* na devolucao/beneficiamento), 2026-11-19c.
//   - "transportadoras": SA4 inteira (codigo e nome), para a edicao.
//   - Endereco do cliente de ENTREGA (2026-11-23a, pedido do usuario):
//     "enderecoEntrega", "complementoEntrega", "bairroEntrega", "cepEntrega"
//     (A1_END/A1_COMPLEM/A1_BAIRRO/A1_CEP; A2_* na devolucao/beneficiamento),
//     do mesmo cadastro da cidade/UF. Coluna que nao existe no SA1/SA2 vai vazia.
//   - "mensagemNota" = C5_MENNOTA (mensagem para a nota), so leitura.
//   - "obsRetorno" = observacao do retorno a empresa (2026-11-23b): NAO fica na
//     SC5 (pedido do usuario, para nao criar mais campo nela). Cada gravacao e
//     uma linha da ZLH com ZLH_CAMPO = "OBSRET" e o texto inteiro no ZLH_OBS
//     (campo criado pelo usuario na ZLH); vale a linha mais recente do pedido
//     (ValoresZlh, desde 2026-11-24b). Sem a ZLH ou o ZLH_OBS: vazio e "ZLH_OBS" em camposFaltando.
//   - Numeros de serie (2026-11-16a, pedido do usuario, igual ao RX Pedidos):
//     cada item ganha "numerosSerie" = [[serie, nf], ...] da Z01 (Z01_PEDIDO,
//     Z01_ITEM, Z01_SERIE, Z01_NFEDO), com e sem NF. Sem a tabela Z01 ou as
//     colunas, os itens vao sem series e "Z01" entra em camposFaltando.
//
// PUT /api/v1/vs-financial-data/logistica/pedidos/:recno  (R_E_C_N_O_ da SC5)
//   Grava direto na SC5 com RecLock (sem MATA410: sem gatilho/validacao do
//   SX3), so os campos enviados no corpo. Regras:
//   - envio >= emissao do pedido; entrega exige envio e entrega >= envio;
//   - campos de reentrega so com C5_ZREENTR = SIM (valor final);
//   - C5_FECENT ("previsaoSaida") e a SAIDA PROGRAMADA (aba Programacao da
//     tela). Desde 2026-11-15b NAO copia mais para o envio (C5_ZDTENV): o
//     envio so e gravado quando o pedido sai de fato (pedido do usuario). A
//     copia existiu de 2026-11-13f a 2026-11-15a;
//   - C5_ZOBS ("obsEntrega"): observacoes da entrega, texto livre. Caracter ou
//     memo: a leitura sai pelo tipo da coluna no Oracle (ObsSql) e a gravacao
//     de memo nao passa pelo limite de tamanho;
//   - retorno exige envio e retorno >= envio; motivo, pedido do reenvio e
//     observacao do retorno ("obsRetorno", gravada na ZLH, 2026-11-23b) so
//     com data do retorno; pedido do reenvio existe na SC5 e e outro pedido;
//   - transportadora, volume, especie (C5_ESPECI1), peso liquido (C5_PESOL) e
//     peso bruto (C5_PBRUTO) so enquanto o pedido NAO tem nota: sao dados da
//     NF-e e tem que estar no pedido antes da emissao (depois ja sairam no
//     documento). Frete destacado (C5_FRETE) e nao destacado (C5_ZFRETE) NAO
//     sao gravados por aqui desde 2026-11-15a: so consulta (pedido do usuario);
//   - combo: so codigo existente no X3_CBOX; texto no limite do TamSX3.
//   Responde o pedido como o GET mostra, para a tela atualizar o cartao.
//
// CUSTOS DE FRETE E HISTORICO (2026-11-19a, pedido do usuario em 19/11/2026)
//   Tabelas novas, criadas pelo U_LOGRELUPD (opcao Tabelas):
//   - ZLC = custos de frete do pedido, uma linha por cobranca (CTE do envio,
//     reentregas, armazenagem, devolucao, outras taxas): ZLC_ITEM (001, 002...,
//     gerado aqui), ZLC_TIPO (E/R/A/D/O), ZLC_CTE, ZLC_DATA, ZLC_TRANSP,
//     ZLC_VALOR, ZLC_SITUA (vazio = ok; D divergente, C em contato, A ajustado,
//     I aceito como veio), ZLC_VLRESP (valor esperado, opcional), ZLC_OBS e
//     quem/quando alterou. Exclusao logica (D_E_L_E_T_).
//   - ZLH = historico da logistica: cada alteracao feita pela tela (ou pela
//     importacao) no pedido (SC5) ou numa cobranca (ZLC): campo, antes, depois,
//     usuario, data e hora.
//   Com a ZLC, os campos de CTE da SC5 (C5_ZCTE, C5_ZVLRCTE, C5_ZCTEREE,
//   C5_ZVCTERE) ficam parados (a carga inicial copia para a ZLC) e as chaves
//   cte/valorCte/cteReentrega/valorCteReentrega do PUT (importacao) gravam na
//   1a cobranca de Envio/Reentrega da ZLC. Sem as tabelas, tudo como antes.
//   Tabela e colunas conferidas no ALL_TAB_COLUMNS (TemTab) antes de usar.
//   - GET  /logistica/pedidos: cada pedido ganha "custos" (lista da ZLC);
//     "temCustos"/"temHistorico" no topo; opcoes "tipoCusto"/"situacaoCusto".
//   - POST /logistica/custos {"recno", "acao": incluir|alterar|excluir,
//     "item", "tipo", "cte", "data", "transportadora", "valor",
//     "valorEsperado", "situacao", "obs"}: responde o pedido como o GET.
//   - GET  /logistica/historico?pedido=NNNNNN: linhas da ZLH, mais novas antes.
//   - PUT  /logistica/pedidos/:recno: grava o historico das mudancas da SC5;
//     "origem": "importacao" no corpo marca a linha como importacao.
//   So rotas no formato das que ja existem (GET com query, POST simples).
//
// LOGISTICA REVERSA (2026-11-24a): GET /logistica/reversa/diagnostico, so
// leitura, antes de desenhar a aba Reversa. Detalhe no bloco da rota.
//
// FINALIZADO SEM ENTREGA, EXTRAVIO E INDICADOR "OUTROS" (2026-11-24b, pedido
// do usuario): ficam na ZLH, NAO na SC5 (escolha do usuario), no mesmo
// caminho da observacao do retorno. Cada chave do PUT abaixo vira uma linha
// da ZLH com o ZLH_CAMPO da lista (CamposZlh), o valor CRU no ZLH_OBS (data
// AAAAMMDD, valor 1234.56, codigo, texto) e o resumo legivel em VALANT/VALNOV
// para o Historico da tela. Vale a linha mais recente de cada pedido+campo
// (ValoresZlh); o GET manda as chaves em cada pedido.
//   finalizado (FINALIZ, "S" ou vazio), motivoFinal (FINMOT: E=Extravio;
//   P=Enviado em outro pedido;O=Outro motivo), dataFinal (FINDATA),
//   pedidoFinal (FINPED, pedido em que a mercadoria foi), reembolso (REEMB:
//   P=Pendente;S=Reembolsado;N=Sem reembolso), valorReembolso (REEMBVL),
//   dataReembolso (REEMBDT), obsFinal (FINOBS), obsIndicador (OBSIND, o que
//   aconteceu quando o indicador de atraso e "Outros") e obsRetorno (OBSRET).
//   Regras: os dados da finalizacao so com finalizado = S; finalizado exige
//   motivo e data (>= emissao), nao vale com retorno nem com entrega; extravio
//   exige envio (data >= envio); "outro pedido" exige o pedido (existe e e
//   outro); "outro motivo" exige a observacao; reembolso so no extravio; data
//   do reembolso so com Reembolsado.
//
// ENVIOS PARCIAIS (2026-11-25a, pedido do usuario em 25/11/2026)
//   Pedido faturado em partes: cada NF e um envio. O 1o envio (NF mais antiga,
//   "nfPrincipal") continua nos campos da SC5 (C5_ZDTENV, C5_ZDTPREV...). Os
//   seguintes ficam na tabela ZLE (envios do pedido, criada pelo U_LOGRELUPD,
//   opcao Tabelas), uma linha por NF: ZLE_DTENV, ZLE_DTPREV, ZLE_DTENTR,
//   ZLE_TPMAT, ZLE_INDICA e ZLE_TRANSP (transportadora do envio; padrao = a da
//   NF, F2_TRANSP). CTE e frete de cada envio sao cobrancas da ZLC com o
//   ZLC_NF (vazio = envio principal).
//   - GET /logistica/pedidos: "nfPrincipal" e "envios" (NFs depois da 1a, com
//     os dados da ZLE ou vazios); "temEnvios" e "temNfCusto" no topo.
//   - POST /logistica/envios {"recno", "nf", "serie", "dataEnvio",
//     "dataPrevisao", "dataEntrega", "tipoMaterial", "indicador",
//     "transportadora"}: grava (inclui ou altera) o envio da NF; campo ausente
//     nao altera, vazio limpa; historico na ZLH. Responde o pedido como o GET.
//   - POST /logistica/custos aceita "nf" (ZLC_NF).
//
// Acesso: SEM a trava U_VSAPIACE/MV_VSAPUSR desde 2026-11-18a, por pedido do
// usuario (18/11/2026). Quem abre a tela pelo menu (U_LOGRELAPP) usa a API.
// Nao depende mais do VSACESSO.tlpp.
// Fonte em ASCII puro e LF; texto com acento sai por EncodeUTF8 (TxtOut).
// ============================================================================

Namespace Videosoft.Logistica.Pedidos

#define LG_VERSAO     "2026-11-25a"
// Combos da finalizacao sem entrega (gravados na ZLH, nao no SX3)
#define FIN_MOTIVOS   "E=Extravio;P=Enviado em outro pedido;O=Outro motivo"
#define FIN_REEMB     "P=Pendente;S=Reembolsado;N=Sem reembolso"
// Dicionario do Oracle so do schema da conexao (2026-11-18a): homologacao e
// producao estao no mesmo Oracle; sem o OWNER, as colunas C5_Z* da homologacao
// "existiam" na producao, a query usava coluna inexistente e a thread caia
// (500 sem X-Erro). Mesmo filtro do RESTPANORAMAESTOQUE.
#define LG_OWNER      "OWNER = SYS_CONTEXT('USERENV','CURRENT_SCHEMA')"
#define LG_DIAS_PADR  365
#define LG_DIAS_MAX   1100
#define LG_BUSCA_MAX  500
// TES que entram na tela mesmo sem movimentar estoque (2026-11-19b, pedido do
// usuario): 610 = remessa para conserto/reparo, usada no inicio da operacao
#define LG_TES_INCLUI "'610'"

/*/{Protheus.doc} getVsLogPedidos
Pedidos de entrega: todos os sem nota + os com nota (TES de saida com estoque) do periodo.
@type function
@author Romulo Garcia
@since 13/11/2026
@queryparam de, Character, opcional. AAAAMMDD. Default = hoje - 365 dias.
@queryparam ate, Character, opcional. AAAAMMDD. Default = hoje.
/*/
@Get("/api/v1/vs-financial-data/logistica/pedidos")
User Function getVsLogPedidos() as Logical
Return LerPedidos()

Static Function LerPedidos()
   Local jQuery      := Nil
   Local jResp       := JsonObject():New()
   Local jOpc        := JsonObject():New()
   Local jRet        := Nil
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local dDe         := CToD("")
   Local dAte        := CToD("")
   Local aFalta      := {}
   Local aPed        := {}
   Local cAlAberto   := ""
   Local lCus        := .F.

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      jQuery := oRest:getQueryRequest()
      If ValType(jQuery) != "J" .and. ValType(jQuery) != "O"
         jQuery := JsonObject():New()
      EndIf

      cEtapa := "01-parametros"
      dAte := SToD(AllTrim(SStr(jQuery["ate"])))
      If Empty(dAte)
         dAte := Date()
      EndIf
      dDe := SToD(AllTrim(SStr(jQuery["de"])))
      If Empty(dDe)
         dDe := dAte - LG_DIAS_PADR
      EndIf
      If dDe > dAte .or. (dAte - dDe) > LG_DIAS_MAX
         jRet := BuildErro(400, "PERIODO_INVALIDO", "Periodo invalido (de <= ate, maximo " + cValToChar(LG_DIAS_MAX) + " dias).")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "02-pedidos"
      aPed := ConsultaPedidos(dDe, dAte, {}, @aFalta, @cEtapa, @cAlAberto)

      cEtapa := "03-opcoes"
      jOpc["tipoMaterial"] := OpcoesCombo("C5_ZTPMAT")
      jOpc["indicador"]    := OpcoesCombo("C5_ZINDICA")
      jOpc["reentrega"]    := OpcoesCombo("C5_ZREENTR")
      jOpc["tipoPedido"]   := OpcoesCombo("C5_ZTPPEDI")
      jOpc["motivoRetorno"]:= OpcoesCombo("C5_ZMOTRET")
      jOpc["motivoFinal"]  := OpcoesBox(FIN_MOTIVOS)
      jOpc["reembolso"]    := OpcoesBox(FIN_REEMB)
      lCus := TemTab("ZLC")
      If lCus
         jOpc["tipoCusto"]     := OpcoesCombo("ZLC_TIPO")
         jOpc["situacaoCusto"] := OpcoesCombo("ZLC_SITUA")
      EndIf

      cEtapa := "04-resposta"
      jResp["versao"]          := LG_VERSAO
      jResp["geradoEm"]        := IsoOut(DToS(Date())) + " " + Time()
      jResp["de"]              := IsoOut(dDe)
      jResp["ate"]             := IsoOut(dAte)
      jResp["camposFaltando"]  := aFalta
      jResp["temCustos"]       := lCus
      jResp["temHistorico"]    := TemTab("ZLH")
      // envios parciais (2026-11-25a): tabela ZLE e NF na cobranca (ZLC_NF)
      jResp["temEnvios"]       := TemTab("ZLE")
      jResp["temNfCusto"]      := lCus .and. ("|ZLC_NF|" $ ColunasDe("ZLC"))
      jResp["opcoes"]          := jOpc
      jResp["tamanhos"]        := Tamanhos()
      jResp["transportadoras"] := Transportadoras()
      jResp["total"]           := Len(aPed)
      jResp["pedidos"]         := aPed
      jRet := oRest:setStatusResponse(200, jResp:ToJson())
      lRespondido := .T.

   Recover Using oErrCap
      // SEMPRE fechar o cursor: vazamento esgota o pool e derruba outras APIs
      If !Empty(cAlAberto) .and. Select(cAlAberto) > 0
         (cAlAberto)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

/*/{Protheus.doc} putVsLogPedido
Grava os dados de logistica do pedido (SC5) pela tela LOGRELAPP.
Campo ausente no corpo = nao altera; texto vazio limpa.
@type function
@author Romulo Garcia
@since 13/11/2026
@pathparam recno, Numeric, R_E_C_N_O_ da SC5 ("recno" do pedido no GET)
@body {"previsaoSaida": "AAAA-MM-DD", "dataEnvio": "AAAA-MM-DD", "dataPrevisao": "...", "dataEntrega": "...", "tipoMaterial": "T", "cte": "...", "valorCte": 0, "reentrega": "S"|"N"|"", "cteReentrega": "...", "valorCteReentrega": 0, "dataNovaEntrega": "...", "indicador": "1", "dataRetorno": "...", "motivoRetorno": "1", "pedidoReenvio": "003500", "transportadora": "000001", "volume": 0, "especie": "CAIXA", "pesoLiquido": 0, "pesoBruto": 0}
/*/
@Put("/api/v1/vs-financial-data/logistica/pedidos/:recno")
User Function putVsLogPedido() as Logical
Return GravaPedido()

Static Function GravaPedido()
   Local jPath       := Nil
   Local jBody       := JsonObject():New()
   Local jRet        := Nil
   Local xErrJson    := Nil
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local lTravou     := .F.
   Local nRecno      := 0
   Local aMapa       := MapaCampos()
   Local aGrava      := {}
   Local aFalta      := {}
   Local cChave      := ""
   Local cCampo      := ""
   Local cTipo       := ""
   Local xVal        := Nil
   Local cTxt        := ""
   Local nI          := 0
   Local nPos        := 0
   Local lComercial  := .F.
   Local lReeCampos  := .F.
   Local lRetCampos  := .F.
   Local dRet        := CToD("")
   Local nTamNum     := 0
   Local cPedido     := ""
   Local dEmis       := CToD("")
   Local dEnv        := CToD("")
   Local dEnt        := CToD("")
   Local dNova       := CToD("")
   Local cReent      := ""
   Local aPed        := {}
   Local aIgnora     := {}
   Local cAlAberto   := ""
   Local lCus        := .F.
   Local lHis        := .F.
   Local lChCus      := .F.
   Local cOrigem     := "1"
   Local aCusto      := {}
   Local aHist       := {}
   Local xAnt        := Nil
   Local xNov        := Nil
   Local cHA         := ""
   Local cHN         := ""
   Local cAvisoH     := ""
   Local cAvisoO     := ""
   Local aCz         := {}
   Local aZlh        := {}
   Local jAtu        := Nil
   Local lZlhOk      := .F.
   Local lZlhConf    := .F.
   Local cErroZ      := ""
   Local cAntZ       := ""
   Local cFin        := ""
   Local cMotF       := ""
   Local dFim        := CToD("")
   Local cPedF       := ""
   Local cReeF       := ""
   Local cVlrF       := ""
   Local dReeF       := CToD("")
   Local cObsF       := ""
   Local dEntFinal   := CToD("")

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      cEtapa := "01-parametros"
      jPath := oRest:getPathParamsRequest()
      If ValType(jPath) == "J" .or. ValType(jPath) == "O"
         nRecno := Val(SStr(jPath["recno"]))
      EndIf
      If nRecno <= 0
         jRet := BuildErro(400, "RECNO_INVALIDO", "Informe o recno do pedido.")
         lRespondido := .T.
         Break
      EndIf
      xErrJson := jBody:FromJson(SStr(oRest:getBodyRequest()))
      If ValType(xErrJson) == "C"
         jRet := BuildErro(400, "JSON_INVALIDO", "Corpo da requisicao nao e um JSON valido.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "02-pedido"
      DbSelectArea("SC5")
      SC5->(DbGoTo(nRecno))
      If SC5->(Eof()) .or. SC5->(Deleted()) .or. SC5->C5_FILIAL != FWxFilial("SC5")
         jRet := BuildErro(404, "PEDIDO_NAO_ENCONTRADO", "Pedido nao encontrado (excluido ou de outra filial).")
         lRespondido := .T.
         Break
      EndIf
      cPedido := SC5->C5_NUM
      dEmis   := SC5->C5_EMISSAO
      // Custos na ZLC e historico na ZLH, se as tabelas existem (2026-11-19a)
      lCus := TemTab("ZLC")
      lHis := TemTab("ZLH")
      If Upper(AllTrim(SStr(jBody["origem"]))) == "IMPORTACAO"
         cOrigem := "2"
      EndIf

      cEtapa := "03-campos"
      For nI := 1 to Len(aMapa)
         cChave := aMapa[nI][1]
         cCampo := aMapa[nI][2]
         cTipo  := aMapa[nI][3]
         If !jBody:HasProperty(cChave)
            Loop
         EndIf
         // CTE e valor (envio e reentrega) vao para a ZLC quando ela existe
         lChCus := lCus .and. ("|" + cCampo + "|") $ "|C5_ZCTE|C5_ZVLRCTE|C5_ZCTEREE|C5_ZVCTERE|"
         If !lChCus .and. SC5->(FieldPos(cCampo)) == 0
            aAdd(aFalta, cCampo)
            Loop
         EndIf
         If cTipo == "D"
            cTxt := AllTrim(SStr(jBody[cChave]))
            xVal := IsoIn(cTxt)
            If !Empty(cTxt) .and. Empty(xVal)
               jRet := BuildErro(400, "DATA_INVALIDA", cChave + ": data invalida (use AAAA-MM-DD).")
               lRespondido := .T.
               Break
            EndIf
         ElseIf cTipo == "N" .or. cTipo == "F"
            xVal := NumIn(jBody[cChave])
            If xVal < 0
               jRet := BuildErro(400, "VALOR_INVALIDO", cChave + ": valor negativo.")
               lRespondido := .T.
               Break
            EndIf
            If cTipo == "F"
               // C5_ZFRETE e CARACTER: grava com ponto decimal, legivel pelo Val()
               // das outras APIs (RESTPEDIDOS usa NNum -> Val)
               xVal := IIf(xVal == 0, "", AllTrim(Str(xVal, 16, 2)))
            EndIf
         ElseIf cTipo == "S"
            cTxt := Upper(AllTrim(TxtIn(jBody[cChave])))
            If !(cTxt $ "|S|N|")
               jRet := BuildErro(400, "SIM_NAO_INVALIDO", cChave + " deve ser S, N ou vazio.")
               lRespondido := .T.
               Break
            EndIf
            xVal := ValorSimNao(cCampo, cTxt)
         ElseIf cTipo == "B"
            xVal := AllTrim(TxtIn(jBody[cChave]))
            If !Empty(xVal) .and. !CodigoNoCombo(cCampo, xVal)
               jRet := BuildErro(400, "OPCAO_INVALIDA", cChave + ": opcao [" + xVal + "] nao existe no combo do " + cCampo + ".")
               lRespondido := .T.
               Break
            EndIf
         ElseIf cTipo == "T"
            xVal := AllTrim(TxtIn(jBody[cChave]))
            If !Empty(xVal) .and. !ExisteTransp(xVal)
               jRet := BuildErro(400, "TRANSPORTADORA_INVALIDA", "Transportadora " + xVal + " nao cadastrada (SA4).")
               lRespondido := .T.
               Break
            EndIf
         ElseIf cTipo == "P"
            // numero de outro pedido (reenvio): completa os zeros e confere na SC5
            xVal := Upper(AllTrim(TxtIn(jBody[cChave])))
            nTamNum := TamSX3("C5_NUM")[1]
            If !Empty(xVal) .and. Len(xVal) < nTamNum .and. SoDigitos(xVal)
               xVal := PadL(xVal, nTamNum, "0")
            EndIf
            If !Empty(xVal) .and. xVal == AllTrim(cPedido)
               jRet := BuildErro(400, "REENVIO_MESMO_PEDIDO", "O pedido do reenvio tem que ser outro pedido.")
               lRespondido := .T.
               Break
            EndIf
            If !Empty(xVal) .and. !ExistePedido(xVal)
               jRet := BuildErro(400, "PEDIDO_REENVIO_INEXISTENTE", "Pedido do reenvio " + xVal + " nao encontrado (SC5).")
               lRespondido := .T.
               Break
            EndIf
         Else
            xVal := AllTrim(TxtIn(jBody[cChave]))
            If cCampo == "C5_ZOBS"
               // quebra de linha: CRLF no memo; espaco no campo caracter
               xVal := StrTran(StrTran(xVal, Chr(13) + Chr(10), Chr(10)), Chr(13), Chr(10))
               xVal := StrTran(xVal, Chr(10), IIf(TamSX3(cCampo)[3] == "M", Chr(13) + Chr(10), " "))
            EndIf
         EndIf
         // texto maior que o campo (memo nao tem limite)
         If lChCus .and. ValType(xVal) == "C" .and. Len(xVal) > TamSX3("ZLC_CTE")[1]
            jRet := BuildErro(400, "TEXTO_GRANDE", cChave + " com mais de " + cValToChar(TamSX3("ZLC_CTE")[1]) + " caracteres.")
            lRespondido := .T.
            Break
         EndIf
         If !lChCus .and. ValType(xVal) == "C" .and. ValType(SC5->(FieldGet(FieldPos(cCampo)))) == "C" .and. TamSX3(cCampo)[3] != "M" .and. Len(xVal) > TamSX3(cCampo)[1]
            jRet := BuildErro(400, "TEXTO_GRANDE", cChave + " com mais de " + cValToChar(TamSX3(cCampo)[1]) + " caracteres.")
            lRespondido := .T.
            Break
         EndIf
         If aMapa[nI][4] == "COM"
            lComercial := .T.
         ElseIf aMapa[nI][4] == "REE" .and. !Empty(xVal)
            lReeCampos := .T.
         ElseIf aMapa[nI][4] == "RET" .and. !Empty(xVal)
            lRetCampos := .T.
         EndIf
         If lChCus
            aAdd(aCusto, {cCampo, xVal})
         Else
            aAdd(aGrava, {cCampo, xVal, cTipo})
         EndIf
      Next nI

      // Campos que ficam na ZLH (ZLH_OBS), nao na SC5: observacao do retorno
      // (2026-11-23b), finalizacao sem entrega, extravio e descricao do
      // indicador "Outros" (2026-11-24b). aZlh = {ZLH_CAMPO, titulo, tipo, valor cru}
      aCz := CamposZlh()
      For nI := 1 to Len(aCz)
         If !jBody:HasProperty(aCz[nI][1])
            Loop
         EndIf
         If !lZlhConf
            lZlhOk   := TemObsRet()
            lZlhConf := .T.
         EndIf
         If !lZlhOk
            If aScan(aFalta, {|x| x == "ZLH_OBS"}) == 0
               aAdd(aFalta, "ZLH_OBS")
            EndIf
            Loop
         EndIf
         cErroZ := ""
         cTxt := ZlhIn(jBody[aCz[nI][1]], aCz[nI][3], cPedido, @cErroZ)
         If !Empty(cErroZ)
            jRet := BuildErro(400, "VALOR_INVALIDO", aCz[nI][1] + ": " + cErroZ)
            lRespondido := .T.
            Break
         EndIf
         aAdd(aZlh, {aCz[nI][2], aCz[nI][4], aCz[nI][3], cTxt})
         If aCz[nI][2] == "OBSRET" .and. !Empty(cTxt)
            lRetCampos := .T.
         EndIf
      Next nI

      If Len(aFalta) > 0
         jRet := BuildErro(400, "CAMPO_INEXISTENTE", "Campos ainda nao criados: " + ArrToTxt(aFalta) + ".")
         lRespondido := .T.
         Break
      EndIf
      If Len(aGrava) == 0 .and. Len(aCusto) == 0 .and. Len(aZlh) == 0
         jRet := BuildErro(400, "SEM_CAMPOS", "Nenhum campo para gravar.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "04-regras"
      // Valores finais = o que veio no corpo ou o que ja esta gravado
      dEnv  := DataFinal(aGrava, "C5_ZDTENV")
      dEnt  := DataFinal(aGrava, "C5_ZDTENTR")
      dNova := DataFinal(aGrava, "C5_ZNDENT")
      nPos  := aScan(aGrava, {|x| x[1] == "C5_ZREENTR"})
      If nPos > 0
         cReent := SimNao(aGrava[nPos][2])
      ElseIf SC5->(FieldPos("C5_ZREENTR")) > 0
         cReent := SimNao(SC5->(FieldGet(FieldPos("C5_ZREENTR"))))
      EndIf
      If !Empty(dEnv) .and. dEnv < dEmis
         jRet := BuildErro(400, "ENVIO_ANTES_EMISSAO", "Data de envio (" + DToC(dEnv) + ") anterior a emissao do pedido (" + DToC(dEmis) + ").")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dEnt) .and. Empty(dEnv)
         jRet := BuildErro(400, "ENTREGA_SEM_ENVIO", "Informe a data de envio antes da data de entrega.")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dEnt) .and. dEnt < dEnv
         jRet := BuildErro(400, "ENTREGA_ANTES_ENVIO", "Data de entrega (" + DToC(dEnt) + ") anterior ao envio (" + DToC(dEnv) + ").")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dNova) .and. !Empty(dEnv) .and. dNova < dEnv
         jRet := BuildErro(400, "NOVA_ENTREGA_ANTES_ENVIO", "Nova data de entrega (" + DToC(dNova) + ") anterior ao envio (" + DToC(dEnv) + ").")
         lRespondido := .T.
         Break
      EndIf
      If lReeCampos .and. cReent != "SIM"
         jRet := BuildErro(400, "SEM_REENTREGA", "CTE, valor e nova data de reentrega so com Gerou reentrega = Sim.")
         lRespondido := .T.
         Break
      EndIf
      dRet := DataFinal(aGrava, "C5_ZDTRET")
      If !Empty(dRet) .and. Empty(dEnv)
         jRet := BuildErro(400, "RETORNO_SEM_ENVIO", "Retorno so para pedido enviado: informe a data de envio.")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dRet) .and. dRet < dEnv
         jRet := BuildErro(400, "RETORNO_ANTES_ENVIO", "Data do retorno (" + DToC(dRet) + ") anterior ao envio (" + DToC(dEnv) + ").")
         lRespondido := .T.
         Break
      EndIf
      If lRetCampos .and. Empty(dRet)
         jRet := BuildErro(400, "SEM_RETORNO", "Motivo, pedido do reenvio e observacao do retorno so com a data do retorno.")
         lRespondido := .T.
         Break
      EndIf

      // Finalizado sem entrega / extravio (2026-11-24b): so quando o corpo
      // traz alguma chave da ZLH. Valor final = o do corpo ou o gravado.
      If Len(aZlh) > 0
         jAtu  := ZlhAtuais(cPedido)
         cFin  := ZlhFinal(aZlh, jAtu, "FINALIZ")
         cMotF := ZlhFinal(aZlh, jAtu, "FINMOT")
         dFim  := SToD(ZlhFinal(aZlh, jAtu, "FINDATA"))
         cPedF := ZlhFinal(aZlh, jAtu, "FINPED")
         cReeF := ZlhFinal(aZlh, jAtu, "REEMB")
         cVlrF := ZlhFinal(aZlh, jAtu, "REEMBVL")
         dReeF := SToD(ZlhFinal(aZlh, jAtu, "REEMBDT"))
         cObsF := ZlhFinal(aZlh, jAtu, "FINOBS")
         dEntFinal := IIf(cReent == "SIM", dNova, dEnt)
         If cFin != "S" .and. !(Empty(cMotF) .and. Empty(dFim) .and. Empty(cPedF) .and. Empty(cReeF) .and. Empty(cVlrF) .and. Empty(dReeF) .and. Empty(cObsF))
            jRet := BuildErro(400, "SEM_FINALIZADO", "Motivo, data, pedido, reembolso e observacao da finalizacao so com o pedido marcado como finalizado.")
            lRespondido := .T.
            Break
         EndIf
         If cFin == "S"
            cErroZ := ""
            If Empty(cMotF)
               cErroZ := "Informe o motivo da finalizacao sem entrega."
            ElseIf Empty(dFim)
               cErroZ := "Informe a data da finalizacao (no extravio, a data do extravio)."
            ElseIf dFim < dEmis
               cErroZ := "Data da finalizacao (" + DToC(dFim) + ") anterior a emissao do pedido (" + DToC(dEmis) + ")."
            ElseIf !Empty(dRet)
               cErroZ := "Pedido com data do retorno ja esta encerrado em Retornados: apague o retorno para finalizar sem entrega."
            ElseIf !Empty(dEntFinal)
               cErroZ := "Pedido com data de entrega ja esta encerrado: apague a data de entrega para finalizar sem entrega."
            ElseIf cMotF == "E" .and. Empty(dEnv)
               cErroZ := "Extravio so para pedido enviado: informe a data de envio."
            ElseIf cMotF == "E" .and. dFim < dEnv
               cErroZ := "Data do extravio (" + DToC(dFim) + ") anterior ao envio (" + DToC(dEnv) + ")."
            ElseIf cMotF == "P" .and. Empty(cPedF)
               cErroZ := "Informe o pedido em que a mercadoria foi enviada."
            ElseIf cMotF == "O" .and. Empty(cObsF)
               cErroZ := "Outro motivo: descreva na observacao o que aconteceu."
            ElseIf cMotF != "E" .and. !(Empty(cReeF) .and. Empty(cVlrF) .and. Empty(dReeF))
               cErroZ := "Reembolso so no extravio."
            ElseIf !Empty(dReeF) .and. cReeF != "S"
               cErroZ := "Data do reembolso so com Reembolsado."
            ElseIf !Empty(dReeF) .and. dReeF < dFim
               cErroZ := "Data do reembolso (" + DToC(dReeF) + ") anterior ao extravio (" + DToC(dFim) + ")."
            EndIf
            If !Empty(cErroZ)
               jRet := BuildErro(400, "FINALIZACAO_INVALIDA", cErroZ)
               lRespondido := .T.
               Break
            EndIf
         EndIf
      EndIf
      If lComercial .and. TemNota(cPedido)
         jRet := BuildErro(409, "PEDIDO_FATURADO", "Pedido " + AllTrim(cPedido) + " ja tem nota: transportadora, volume, especie e pesos nao podem mais ser alterados aqui.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "05-gravacao"
      If Len(aGrava) > 0
         If !RecLock("SC5", .F.)
            jRet := BuildErro(409, "PEDIDO_EM_USO", "Pedido " + AllTrim(cPedido) + " em uso por outro usuario. Tente de novo.")
            lRespondido := .T.
            Break
         EndIf
         lTravou := .T.
         For nI := 1 to Len(aGrava)
            nPos := SC5->(FieldPos(aGrava[nI][1]))
            xAnt := SC5->(FieldGet(nPos))
            xNov := Converte(aGrava[nI][2], ValType(xAnt))
            // historico: so o que mudou de fato (antes x depois em texto)
            cHA := HistTxt(xAnt, aGrava[nI][1])
            cHN := HistTxt(xNov, aGrava[nI][1])
            If !(cHA == cHN)
               aAdd(aHist, {"", "A", aGrava[nI][1], TituloCampo(aGrava[nI][1]), cHA, cHN})
            EndIf
            SC5->(FieldPut(nPos, xNov))
         Next nI
         SC5->(MsUnlock())
         lTravou := .F.
      EndIf

      cEtapa := "05b-custos"
      If Len(aCusto) > 0
         CustoDoPedido(cPedido, aCusto, dEnv, dNova, SC5->C5_TRANSP, @aHist)
      EndIf

      cEtapa := "05c-historico"
      If lHis .and. Len(aHist) > 0
         cAvisoH := GravaHists(cPedido, aHist, cOrigem)
      EndIf

      cEtapa := "05d-zlh"
      For nI := 1 to Len(aZlh)
         cAntZ := IIf(ValType(jAtu[aZlh[nI][1]]) == "C", jAtu[aZlh[nI][1]], "")
         If !(cAntZ == aZlh[nI][4])
            cAvisoO += GravaZlh(cPedido, aZlh[nI][1], aZlh[nI][2], aZlh[nI][3], cAntZ, aZlh[nI][4], cOrigem)
         EndIf
      Next nI

      cEtapa := "06-resposta"
      aPed := ConsultaPedidos(CToD(""), CToD(""), {cPedido}, @aIgnora, @cEtapa, @cAlAberto)
      If Len(aPed) > 0
         If !Empty(cAvisoH) .or. !Empty(cAvisoO)
            aPed[1]["avisoHistorico"] := TxtOut(AllTrim(cAvisoH + " " + cAvisoO))
         EndIf
         jRet := oRest:setStatusResponse(200, aPed[1]:ToJson())
      Else
         // gravou, mas o pedido nao tem item (nao deveria acontecer na busca sem filtro)
         jRet := oRest:setStatusResponse(200, '{"recno":' + cValToChar(nRecno) + ',"aviso":"gravado"}')
      EndIf
      lRespondido := .T.

   Recover Using oErrCap
      If lTravou
         SC5->(MsUnlock())
      EndIf
      If !Empty(cAlAberto) .and. Select(cAlAberto) > 0
         (cAlAberto)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

/*/{Protheus.doc} postVsLogBusca
Pedidos pelo numero, sem filtro de periodo, TES, tipo ou residuo (importacao da tela).
@type function
@author Romulo Garcia
@since 13/11/2026
@body {"pedidos": ["000009", "000010"]}  (ate LG_BUSCA_MAX numeros)
/*/
@Post("/api/v1/vs-financial-data/logistica/pedidos/busca")
User Function postVsLogBusca() as Logical
Return BuscaPedidos()

Static Function BuscaPedidos()
   Local jBody       := JsonObject():New()
   Local jResp       := JsonObject():New()
   Local jRet        := Nil
   Local xErrJson    := Nil
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local aNums       := {}
   Local aLista      := {}
   Local aPed        := {}
   Local aIgnora     := {}
   Local aNao        := {}
   Local cAlAberto   := ""
   Local cNum        := ""
   Local nI          := 0
   Local nTam        := 0

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      cEtapa := "01-parametros"
      xErrJson := jBody:FromJson(SStr(oRest:getBodyRequest()))
      If ValType(xErrJson) == "C"
         jRet := BuildErro(400, "JSON_INVALIDO", "Corpo da requisicao nao e um JSON valido.")
         lRespondido := .T.
         Break
      EndIf
      aNums := jBody["pedidos"]
      If ValType(aNums) != "A" .or. Len(aNums) == 0
         jRet := BuildErro(400, "SEM_PEDIDOS", "Informe a lista de pedidos.")
         lRespondido := .T.
         Break
      EndIf
      If Len(aNums) > LG_BUSCA_MAX
         jRet := BuildErro(400, "PEDIDOS_DEMAIS", "No maximo " + cValToChar(LG_BUSCA_MAX) + " pedidos por chamada.")
         lRespondido := .T.
         Break
      EndIf
      nTam := TamSX3("C5_NUM")[1]
      For nI := 1 to Len(aNums)
         If ValType(aNums[nI]) == "N"
            cNum := cValToChar(aNums[nI])
         Else
            cNum := Upper(AllTrim(SStr(aNums[nI])))
         EndIf
         If Empty(cNum) .or. Len(cNum) > nTam
            Loop
         EndIf
         cNum := PadR(cNum, nTam)
         If aScan(aLista, {|x| x == cNum}) == 0
            aAdd(aLista, cNum)
         EndIf
      Next nI
      If Len(aLista) == 0
         jRet := BuildErro(400, "SEM_PEDIDOS", "Nenhum numero de pedido valido na lista.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "02-pedidos"
      aPed := ConsultaPedidos(CToD(""), CToD(""), aLista, @aIgnora, @cEtapa, @cAlAberto)

      cEtapa := "03-resposta"
      For nI := 1 to Len(aLista)
         cNum := AllTrim(aLista[nI])
         If aScan(aPed, {|j| j["pedido"] == cNum}) == 0
            aAdd(aNao, cNum)
         EndIf
      Next nI
      jResp["versao"]         := LG_VERSAO
      jResp["pedidos"]        := aPed
      jResp["naoEncontrados"] := aNao
      jRet := oRest:setStatusResponse(200, jResp:ToJson())
      lRespondido := .T.

   Recover Using oErrCap
      If !Empty(cAlAberto) .and. Select(cAlAberto) > 0
         (cAlAberto)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

// {chave do JSON, campo, tipo, grupo}
// tipo: D data, N numero, F frete texto (C5_ZFRETE), S sim/nao (combo),
//       B codigo de combo, T transportadora (SA4), C texto
//       P numero de outro pedido (SC5)
// grupo: LOG logistica, REE reentrega, RET retorno (so com data do retorno),
//        COM comercial (so antes da nota)
Static Function MapaCampos()
   Local aMapa := {}
   aAdd(aMapa, {"previsaoSaida",     "C5_FECENT",  "D", "LOG"})
   aAdd(aMapa, {"dataEnvio",         "C5_ZDTENV",  "D", "LOG"})
   aAdd(aMapa, {"dataPrevisao",      "C5_ZDTPREV", "D", "LOG"})
   aAdd(aMapa, {"dataEntrega",       "C5_ZDTENTR", "D", "LOG"})
   aAdd(aMapa, {"tipoMaterial",      "C5_ZTPMAT",  "B", "LOG"})
   aAdd(aMapa, {"cte",               "C5_ZCTE",    "C", "LOG"})
   aAdd(aMapa, {"valorCte",          "C5_ZVLRCTE", "N", "LOG"})
   aAdd(aMapa, {"reentrega",         "C5_ZREENTR", "S", "LOG"})
   aAdd(aMapa, {"cteReentrega",      "C5_ZCTEREE", "C", "REE"})
   aAdd(aMapa, {"valorCteReentrega", "C5_ZVCTERE", "N", "REE"})
   aAdd(aMapa, {"dataNovaEntrega",   "C5_ZNDENT",  "D", "REE"})
   aAdd(aMapa, {"indicador",         "C5_ZINDICA", "B", "LOG"})
   aAdd(aMapa, {"dataRetorno",       "C5_ZDTRET",  "D", "LOG"})
   aAdd(aMapa, {"motivoRetorno",     "C5_ZMOTRET", "B", "RET"})
   aAdd(aMapa, {"pedidoReenvio",     "C5_ZPEDREN", "P", "RET"})
   aAdd(aMapa, {"obsEntrega",        "C5_ZOBS",    "C", "LOG"})
   aAdd(aMapa, {"transportadora",    "C5_TRANSP",  "T", "COM"})
   aAdd(aMapa, {"volume",            "C5_VOLUME1", "N", "COM"})
   aAdd(aMapa, {"especie",           "C5_ESPECI1", "C", "COM"})
   aAdd(aMapa, {"pesoLiquido",       "C5_PESOL",   "N", "COM"})
   aAdd(aMapa, {"pesoBruto",         "C5_PBRUTO",  "N", "COM"})
   // frete destacado (C5_FRETE) e nao destacado (C5_ZFRETE): so consulta
   // desde 2026-11-15a (pedido do usuario); o GET continua mandando
Return aMapa

// Titulo legivel do campo (SC5 ou ZLC) para o historico (ZLH_TITULO)
Static Function TituloCampo(cCampo)
   Local aT := {{"C5_FECENT", "Saida programada"}, ;
      {"C5_ZDTENV", "Data de envio"}, ;
      {"C5_ZDTPREV", "Previsao de entrega"}, ;
      {"C5_ZDTENTR", "Data de entrega"}, ;
      {"C5_ZTPMAT", "Tipo de material"}, ;
      {"C5_ZCTE", "CTE"}, ;
      {"C5_ZVLRCTE", "Valor do CTE"}, ;
      {"C5_ZREENTR", "Gerou reentrega"}, ;
      {"C5_ZCTEREE", "CTE da reentrega"}, ;
      {"C5_ZVCTERE", "Valor CTE reentrega"}, ;
      {"C5_ZNDENT", "Nova data de entrega"}, ;
      {"C5_ZINDICA", "Indicador de atraso"}, ;
      {"C5_ZDTRET", "Data do retorno"}, ;
      {"C5_ZMOTRET", "Motivo do retorno"}, ;
      {"C5_ZPEDREN", "Pedido do reenvio"}, ;
      {"C5_ZOBS", "Observacoes da entrega"}, ;
      {"OBSRET", "Observacao do retorno"}, ;
      {"C5_TRANSP", "Transportadora"}, ;
      {"C5_VOLUME1", "Volume"}, ;
      {"C5_ESPECI1", "Especie"}, ;
      {"C5_PESOL", "Peso liquido"}, ;
      {"C5_PBRUTO", "Peso bruto"}, ;
      {"ZLC_TIPO", "Tipo da cobranca"}, ;
      {"ZLC_CTE", "CTE / documento"}, ;
      {"ZLC_DATA", "Data da cobranca"}, ;
      {"ZLC_TRANSP", "Transportadora da cobranca"}, ;
      {"ZLC_VALOR", "Valor cobrado"}, ;
      {"ZLC_SITUA", "Situacao"}, ;
      {"ZLC_VLRESP", "Valor esperado"}, ;
      {"ZLC_OBS", "Observacao da cobranca"}, ;
      {"ZLC_NF", "NF do envio"}}
   Local nP := aScan(aT, {|x| x[1] == AllTrim(cCampo)})
Return IIf(nP > 0, aT[nP][2], AllTrim(cCampo))

// Data final do campo: a do corpo, senao a gravada (campo inexistente = vazia)
Static Function DataFinal(aGrava, cCampo)
   Local nPos := aScan(aGrava, {|x| x[1] == cCampo})
   Local xV   := Nil
   If nPos > 0
      Return aGrava[nPos][2]
   EndIf
   If SC5->(FieldPos(cCampo)) == 0
      Return CToD("")
   EndIf
   xV := SC5->(FieldGet(FieldPos(cCampo)))
   If ValType(xV) == "D"
      Return xV
   EndIf
Return IsoIn(xV)

// Valor validado -> tipo real do campo na SC5 (o tipo dos Z* nao foi conferido)
Static Function Converte(xVal, cTipoCampo)
   If cTipoCampo == "D"
      If ValType(xVal) == "D"
         Return xVal
      EndIf
      Return IsoIn(xVal)
   ElseIf cTipoCampo == "N"
      If ValType(xVal) == "N"
         Return xVal
      EndIf
      Return ValTxt(SStr(xVal))
   EndIf
   // campo caracter
   If ValType(xVal) == "D"
      Return DToS(xVal)
   ElseIf ValType(xVal) == "N"
      Return IIf(xVal == 0, "", AllTrim(Str(xVal, 16, 2)))
   EndIf
Return SStr(xVal)

// Algum item do pedido com nota real (C5_NOTA/C6_NOTA "XXX..." = residuo, nao e nota)
Static Function TemNota(cPedido)
   Local cQuery := ""
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   Local lRet   := .F.
   cQuery := "SELECT COUNT(*) AS QTD FROM " + RetSqlName("SC6") + " SC6 "
   cQuery += "WHERE SC6.C6_FILIAL = ? AND SC6.C6_NUM = ? AND SC6.C6_NOTA <> ' ' "
   cQuery += "  AND SC6.C6_NOTA NOT LIKE 'X%' AND SC6.D_E_L_E_T_ = ' ' "
   oStmt := FWExecStatement():New(cQuery)
   oStmt:SetString(1, FWxFilial("SC6"))
   oStmt:SetString(2, cPedido)
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      lRet := NNum((cAl)->QTD) > 0
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return lRet

// Pedido existe na filial (por SQL: nao mexe no registro posicionado da SC5)
Static Function ExistePedido(cNum)
   Local cAl   := GetNextAlias()
   Local oStmt := Nil
   Local lRet  := .F.
   oStmt := FWExecStatement():New("SELECT COUNT(*) AS QTD FROM " + RetSqlName("SC5") + " WHERE C5_FILIAL = ? AND C5_NUM = ? AND D_E_L_E_T_ = ' '")
   oStmt:SetString(1, FWxFilial("SC5"))
   oStmt:SetString(2, PadR(cNum, TamSX3("C5_NUM")[1]))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      lRet := NNum((cAl)->QTD) > 0
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return lRet

Static Function SoDigitos(cTxt)
   Local nI := 0
   For nI := 1 to Len(cTxt)
      If !IsDigit(SubStr(cTxt, nI, 1))
         Return .F.
      EndIf
   Next nI
Return .T.

Static Function ExisteTransp(cCod)
   Local lRet := .F.
   DbSelectArea("SA4")
   SA4->(DbSetOrder(1))
   lRet := SA4->(DbSeek(FWxFilial("SA4") + cCod))
Return lRet

// ----------------------------------------------------------------------------
// Consulta principal. aLista com numeros (C5_NUM no tamanho do campo) = so
// esses pedidos, sem filtro de periodo, TES, tipo ou residuo.
// aFalta recebe os campos opcionais que nao existem na SC5.
// ----------------------------------------------------------------------------
Static Function ConsultaPedidos(dDe, dAte, aLista, aFalta, cEtapa, cAlAberto)
   Local aPed    := {}
   Local lTemPed := .F.
   Local cExist  := ColunasExistentes()
   Local cExA1   := ColunasDe("SA1")
   Local cExA2   := ColunasDe("SA2")
   Local cQuery  := ""
   Local cAlias  := GetNextAlias()
   Local oStmt   := Nil
   Local aBinds  := {}
   Local nB      := 0
   Local cAtual  := ""
   Local jPed    := Nil
   Local aItens  := {}
   Local jIt     := Nil
   Local cNota   := ""
   Local aNotas  := {}
   Local cDtFat  := ""
   Local cFrTxt  := ""
   // NFs de cada pedido (mesma ordem do aPed): {nf, serie, emissao, transportadora}
   Local aNfsAll := {}
   Local aNfs    := {}
   Local cSerNf  := ""

   aFalta := {}
   cEtapa := "02a-query"
   cQuery := "SELECT SC5.R_E_C_N_O_ AS RECSC5, SC5.C5_NUM AS PEDIDO, SC5.C5_EMISSAO AS EMISSAO, SC5.C5_TIPO AS TIPONF, "
   cQuery += "       SC5.C5_CLIENTE AS CLIENTE, SC5.C5_LOJACLI AS LOJA, SC5.C5_CLIENT AS CLIENT, SC5.C5_LOJAENT AS LOJAENT, "
   cQuery += "       SC5.C5_FECENT AS FECENT, SC5.C5_VEND1 AS CODVEND, SC5.C5_TRANSP AS CODTRANSP, SC5.C5_FRETE AS FRETE, "
   // devolucao/beneficiamento (D/B): o "cliente" e fornecedor (SA2)
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SA2.A2_NOME ELSE SA1.A1_NOME END AS NOME, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SA2.A2_NREDUZ ELSE SA1.A1_NREDUZ END AS FANTASIA, "
   cQuery += "       SA1.A1_GRPVEN AS CODGRP, ACY.ACY_DESCRI AS GRUPO, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SFE.A2_NOME ELSE SAE.A1_NOME END AS NOMEENT, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SFE.A2_MUN ELSE SAE.A1_MUN END AS CIDADE, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SFE.A2_EST ELSE SAE.A1_EST END AS UF, "
   // telefone (2026-11-19c, pedido do usuario): do cliente de entrega e do cliente do pedido
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SFE.A2_DDD ELSE SAE.A1_DDD END AS DDDENT, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SFE.A2_TEL ELSE SAE.A1_TEL END AS TELENT, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SA2.A2_DDD ELSE SA1.A1_DDD END AS DDDCLI, "
   cQuery += "       CASE WHEN SC5.C5_TIPO IN ('D','B') THEN SA2.A2_TEL ELSE SA1.A1_TEL END AS TELCLI, "
   // endereco do cliente de entrega (2026-11-23a): mesmo cadastro da cidade/UF
   cQuery += "       " + EndCol(cExA1, cExA2, "END", "ENDENT") + ", "
   cQuery += "       " + EndCol(cExA1, cExA2, "COMPLEM", "COMPENT") + ", "
   cQuery += "       " + EndCol(cExA1, cExA2, "BAIRRO", "BAIRENT") + ", "
   cQuery += "       " + EndCol(cExA1, cExA2, "CEP", "CEPENT") + ", "
   cQuery += "       SA3.A3_NOME AS VENDEDOR, SA4.A4_NOME AS TRANSP, "
   cQuery += "       " + ColOpc(cExist, "C5_ZTPPEDI", "TIPOPED", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZFRETE", "ZFRETE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_VOLUME1", "VOLUME", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ESPECI1", "ESPECIE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_PESOL", "PESOL", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_PBRUTO", "PBRUTO", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZDTENV", "DTENV", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZDTPREV", "DTPREV", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZDTENTR", "DTENTR", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZTPMAT", "TPMAT", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZCTE", "CTE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZVLRCTE", "VLRCTE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZREENTR", "REENTR", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZCTEREE", "CTEREE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZVCTERE", "VCTERE", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZNDENT", "NDENT", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZINDICA", "INDICA", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZDTRET", "DTRET", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZMOTRET", "MOTRET", @aFalta) + ", "
   cQuery += "       " + ColOpc(cExist, "C5_ZPEDREN", "PEDREN", @aFalta) + ", "
   cQuery += "       " + ObsSql(cExist, @aFalta, "C5_ZOBS") + " AS OBSENT, "
   cQuery += "       " + ObsSql(cExist, @aFalta, "C5_MENNOTA") + " AS MENNOTA, "
   cQuery += "       SC6.C6_ITEM AS ITEM, SC6.C6_PRODUTO AS PRODUTO, SC6.C6_DESCRI AS DESCRI, "
   cQuery += "       SC6.C6_QTDVEN AS QTDVEN, SC6.C6_QTDENT AS QTDENT, SC6.C6_VALOR AS VALOR, "
   cQuery += "       SC6.C6_TES AS TES, SF4.F4_TEXTO AS DESCTES, SC6.C6_NOTA AS NOTA, SC6.C6_SERIE AS SERIE, "
   cQuery += "       SF2.F2_EMISSAO AS DTFAT, SF2.F2_TRANSP AS NFTRANSP "
   cQuery += "FROM " + RetSqlName("SC6") + " SC6 "
   cQuery += "INNER JOIN " + RetSqlName("SC5") + " SC5 ON SC5.C5_FILIAL = SC6.C6_FILIAL "
   cQuery += "    AND SC5.C5_NUM = SC6.C6_NUM AND SC5.D_E_L_E_T_ = ' ' "
   // TES (filial exata para nao duplicar). LEFT: pedido sem nota entra com qualquer TES
   cQuery += "LEFT JOIN " + RetSqlName("SF4") + " SF4 ON SF4.F4_FILIAL = '" + FWxFilial("SF4") + "' "
   cQuery += "    AND SF4.F4_CODIGO = SC6.C6_TES AND SF4.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA1") + " SA1 ON (SA1.A1_FILIAL = '" + FWxFilial("SA1") + "' OR SA1.A1_FILIAL = ' ') "
   cQuery += "    AND SA1.A1_COD = SC5.C5_CLIENTE AND SA1.A1_LOJA = SC5.C5_LOJACLI AND SC5.C5_TIPO NOT IN ('D','B') AND SA1.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA1") + " SAE ON (SAE.A1_FILIAL = '" + FWxFilial("SA1") + "' OR SAE.A1_FILIAL = ' ') "
   cQuery += "    AND SAE.A1_COD = SC5.C5_CLIENT AND SAE.A1_LOJA = SC5.C5_LOJAENT AND SC5.C5_TIPO NOT IN ('D','B') AND SAE.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA2") + " SA2 ON (SA2.A2_FILIAL = '" + FWxFilial("SA2") + "' OR SA2.A2_FILIAL = ' ') "
   cQuery += "    AND SA2.A2_COD = SC5.C5_CLIENTE AND SA2.A2_LOJA = SC5.C5_LOJACLI AND SC5.C5_TIPO IN ('D','B') AND SA2.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA2") + " SFE ON (SFE.A2_FILIAL = '" + FWxFilial("SA2") + "' OR SFE.A2_FILIAL = ' ') "
   cQuery += "    AND SFE.A2_COD = SC5.C5_CLIENT AND SFE.A2_LOJA = SC5.C5_LOJAENT AND SC5.C5_TIPO IN ('D','B') AND SFE.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("ACY") + " ACY ON (ACY.ACY_FILIAL = '" + FWxFilial("ACY") + "' OR ACY.ACY_FILIAL = ' ') "
   cQuery += "    AND ACY.ACY_GRPVEN = SA1.A1_GRPVEN AND SA1.A1_GRPVEN <> ' ' AND ACY.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA3") + " SA3 ON (SA3.A3_FILIAL = '" + FWxFilial("SA3") + "' OR SA3.A3_FILIAL = ' ') "
   cQuery += "    AND SA3.A3_COD = SC5.C5_VEND1 AND SA3.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SA4") + " SA4 ON (SA4.A4_FILIAL = '" + FWxFilial("SA4") + "' OR SA4.A4_FILIAL = ' ') "
   cQuery += "    AND SA4.A4_COD = SC5.C5_TRANSP AND SC5.C5_TRANSP <> ' ' AND SA4.D_E_L_E_T_ = ' ' "
   cQuery += "LEFT JOIN " + RetSqlName("SF2") + " SF2 ON (SF2.F2_FILIAL = '" + FWxFilial("SF2") + "' OR SF2.F2_FILIAL = ' ') "
   cQuery += "    AND SF2.F2_DOC = SC6.C6_NOTA AND SF2.F2_SERIE = SC6.C6_SERIE AND SC6.C6_NOTA <> ' ' AND SF2.D_E_L_E_T_ = ' ' "
   cQuery += "WHERE SC6.C6_FILIAL = ? AND SC6.D_E_L_E_T_ = ' ' "
   aAdd(aBinds, FWxFilial("SC6"))
   If Len(aLista) > 0
      // busca pelo numero (importacao, resposta do PUT): sem nenhum outro filtro
      cQuery += "  AND SC5.C5_NUM IN ("
      For nB := 1 to Len(aLista)
         cQuery += IIf(nB > 1, ",", "") + "?"
         aAdd(aBinds, aLista[nB])
      Next nB
      cQuery += ") "
   Else
      cQuery += "  AND SC6.C6_BLQ <> 'R' "
      // remessa por conta e ordem (5923/6923): o transporte vai em outro pedido
      cQuery += "  AND SUBSTR(SC6.C6_CF, 2, 3) <> '923' "
      // a) emitido no periodo: TES de saida com estoque em pedido normal, ou
      //    pedido com data de envio (qualquer TES/tipo)
      cQuery += "  AND ( ( SC5.C5_EMISSAO BETWEEN ? AND ? "
      aAdd(aBinds, DToS(dDe))
      aAdd(aBinds, DToS(dAte))
      cQuery += "          AND ( ( SC5.C5_TIPO = 'N' AND SF4.F4_TIPO = 'S' AND SF4.F4_ESTOQUE = 'S' ) "
      cQuery += "                OR SC6.C6_TES IN (" + LG_TES_INCLUI + ") "
      If "|C5_ZDTENV|" $ cExist
         cQuery += "                OR SC5.C5_ZDTENV <> ' ' "
      EndIf
      cQuery += "              ) ) "
      // b) sem nota em nenhum item (C6_NOTA "XXX..." = residuo, nao e nota): todos
      cQuery += "     OR NOT EXISTS (SELECT 1 FROM " + RetSqlName("SC6") + " NFI "
      cQuery += "                     WHERE NFI.C6_FILIAL = SC6.C6_FILIAL AND NFI.C6_NUM = SC6.C6_NUM "
      cQuery += "                       AND NFI.C6_NOTA <> ' ' AND NFI.C6_NOTA NOT LIKE 'X%' AND NFI.D_E_L_E_T_ = ' ') ) "
   EndIf
   cQuery += "ORDER BY SC5.C5_NUM, SC6.C6_ITEM "

   oStmt := FWExecStatement():New(cQuery)
   For nB := 1 to Len(aBinds)
      oStmt:SetString(nB, aBinds[nB])
   Next nB
   cAlias := oStmt:OpenAlias(cAlias)
   If Empty(cAlias) .or. Select(cAlias) == 0
      oStmt:Destroy()
      UserException("Nao foi possivel executar a consulta dos pedidos.")
   EndIf
   // o Recover de quem chamou fecha o cursor se der erro no meio da leitura
   cAlAberto := cAlias

   cEtapa := "02b-cursor"
   Do While !(cAlias)->(Eof())
      If (cAlias)->PEDIDO != cAtual
         If lTemPed
            FechaPedido(jPed, aItens, aNotas, cDtFat)
            aAdd(aPed, jPed)
            aAdd(aNfsAll, aNfs)
         EndIf
         lTemPed := .T.
         cAtual := (cAlias)->PEDIDO
         aItens := {}
         aNotas := {}
         aNfs   := {}
         cDtFat := ""
         jPed := JsonObject():New()
         jPed["recno"]             := NNum((cAlias)->RECSC5)
         jPed["pedido"]            := AllTrim((cAlias)->PEDIDO)
         jPed["emissao"]           := IsoOut((cAlias)->EMISSAO)
         jPed["tipoNf"]            := AllTrim(SStr((cAlias)->TIPONF))
         jPed["cliente"]           := AllTrim(SStr((cAlias)->CLIENTE))
         jPed["loja"]              := AllTrim(SStr((cAlias)->LOJA))
         jPed["nome"]              := TxtOut((cAlias)->NOME)
         jPed["fantasia"]          := TxtOut((cAlias)->FANTASIA)
         jPed["grupo"]             := TxtOut((cAlias)->GRUPO)
         jPed["clienteEntrega"]    := AllTrim(SStr((cAlias)->CLIENT)) + "/" + AllTrim(SStr((cAlias)->LOJAENT))
         jPed["nomeEntrega"]       := TxtOut((cAlias)->NOMEENT)
         jPed["cidade"]            := TxtOut((cAlias)->CIDADE)
         jPed["uf"]                := AllTrim(SStr((cAlias)->UF))
         jPed["telefone"]          := Fone((cAlias)->DDDENT, (cAlias)->TELENT)
         jPed["telefoneCliente"]   := Fone((cAlias)->DDDCLI, (cAlias)->TELCLI)
         jPed["vendedor"]          := TxtOut((cAlias)->VENDEDOR)
         jPed["codVendedor"]       := AllTrim(SStr((cAlias)->CODVEND))
         jPed["tipoPedido"]        := AllTrim(SStr((cAlias)->TIPOPED))
         jPed["previsaoSaida"]     := IsoOut((cAlias)->FECENT)
         jPed["transportadora"]    := AllTrim(SStr((cAlias)->CODTRANSP))
         jPed["transportadoraNome"]:= TxtOut((cAlias)->TRANSP)
         jPed["frete"]             := NNum((cAlias)->FRETE)
         cFrTxt := AllTrim(cValToChar((cAlias)->ZFRETE))
         jPed["freteNaoDestacadoTexto"] := TxtOut(cFrTxt)
         jPed["freteNaoDestacado"] := ValTxt(cFrTxt)
         jPed["volume"]            := NNum((cAlias)->VOLUME)
         jPed["especie"]           := TxtOut(cValToChar((cAlias)->ESPECIE))
         jPed["pesoLiquido"]       := NNum((cAlias)->PESOL)
         jPed["pesoBruto"]         := NNum((cAlias)->PBRUTO)
         jPed["dataEnvio"]         := IsoOut((cAlias)->DTENV)
         jPed["dataPrevisao"]      := IsoOut((cAlias)->DTPREV)
         jPed["dataEntrega"]       := IsoOut((cAlias)->DTENTR)
         jPed["tipoMaterial"]      := AllTrim(cValToChar((cAlias)->TPMAT))
         jPed["cte"]               := TxtOut(cValToChar((cAlias)->CTE))
         jPed["valorCte"]          := NNum((cAlias)->VLRCTE)
         jPed["reentrega"]         := SimNao((cAlias)->REENTR)
         jPed["cteReentrega"]      := TxtOut(cValToChar((cAlias)->CTEREE))
         jPed["valorCteReentrega"] := NNum((cAlias)->VCTERE)
         jPed["dataNovaEntrega"]   := IsoOut((cAlias)->NDENT)
         jPed["indicador"]         := AllTrim(cValToChar((cAlias)->INDICA))
         jPed["dataRetorno"]       := IsoOut((cAlias)->DTRET)
         jPed["motivoRetorno"]     := AllTrim(cValToChar((cAlias)->MOTRET))
         jPed["pedidoReenvio"]     := AllTrim(cValToChar((cAlias)->PEDREN))
         jPed["obsEntrega"]        := TxtOut(cValToChar((cAlias)->OBSENT))
         jPed["mensagemNota"]      := TxtOut(cValToChar((cAlias)->MENNOTA))
         jPed["enderecoEntrega"]   := TxtOut(cValToChar((cAlias)->ENDENT))
         jPed["complementoEntrega"]:= TxtOut(cValToChar((cAlias)->COMPENT))
         jPed["bairroEntrega"]     := TxtOut(cValToChar((cAlias)->BAIRENT))
         jPed["cepEntrega"]        := AllTrim(cValToChar((cAlias)->CEPENT))
      EndIf

      jIt := JsonObject():New()
      cNota := AllTrim(SStr((cAlias)->NOTA))
      If Left(cNota, 1) == "X"
         cNota := ""
      EndIf
      jIt["item"]        := AllTrim((cAlias)->ITEM)
      jIt["produto"]     := AllTrim((cAlias)->PRODUTO)
      jIt["descricao"]   := TxtOut((cAlias)->DESCRI)
      jIt["quantidade"]  := NNum((cAlias)->QTDVEN)
      jIt["entregue"]    := NNum((cAlias)->QTDENT)
      jIt["valor"]       := Round(NNum((cAlias)->VALOR), 2)
      jIt["tes"]         := AllTrim(SStr((cAlias)->TES))
      jIt["descTes"]     := TxtOut((cAlias)->DESCTES)
      jIt["nota"]        := cNota
      jIt["serie"]       := IIf(Empty(cNota), "", AllTrim(SStr((cAlias)->SERIE)))
      jIt["dataFat"]     := IIf(Empty(cNota), "", IsoOut((cAlias)->DTFAT))
      aAdd(aItens, jIt)
      If !Empty(cNota) .and. aScan(aNotas, {|x| x == cNota}) == 0
         aAdd(aNotas, cNota)
      EndIf
      If !Empty(cNota)
         cSerNf := AllTrim(SStr((cAlias)->SERIE))
         If aScan(aNfs, {|x| x[1] == cNota .and. x[2] == cSerNf}) == 0
            aAdd(aNfs, {cNota, cSerNf, IsoOut((cAlias)->DTFAT), AllTrim(SStr((cAlias)->NFTRANSP))})
         EndIf
      EndIf
      If !Empty(jIt["dataFat"]) .and. jIt["dataFat"] > cDtFat
         cDtFat := jIt["dataFat"]
      EndIf
      (cAlias)->(DbSkip())
   EndDo
   (cAlias)->(DbCloseArea())
   oStmt:Destroy()
   cAlAberto := ""
   If lTemPed
      FechaPedido(jPed, aItens, aNotas, cDtFat)
      aAdd(aPed, jPed)
      aAdd(aNfsAll, aNfs)
   EndIf

   cEtapa := "02c-series"
   NumerosSerie(aPed, @aFalta)

   cEtapa := "02d-custos"
   CustosPedidos(aPed)

   cEtapa := "02e-zlh"
   ValoresZlh(aPed, @aFalta)

   cEtapa := "02f-envios"
   EnviosPedidos(aPed, aNfsAll)
Return aPed

// Envios parciais (2026-11-25a): pedido com 2 ou mais NFs ganha "nfPrincipal"
// (a NF mais antiga: o envio dos campos da SC5) e "envios" (as outras NFs, com
// os dados da ZLE ou vazios; transportadora padrao = a da NF). Pedido de uma NF
// so: envios = [].
Static Function EnviosPedidos(aPed, aNfsAll)
   Local jZle   := JsonObject():New()
   Local lZle   := .F.
   Local aLote  := {}
   Local aN     := {}
   Local aEnv   := {}
   Local jE     := Nil
   Local jZ     := Nil
   Local cKey   := ""
   Local nI     := 0
   Local nJ     := 0

   If Len(aPed) == 0
      Return Nil
   EndIf
   lZle := TemTab("ZLE")
   If lZle
      For nI := 1 to Len(aPed)
         If Len(aNfsAll[nI]) >= 2
            aAdd(aLote, aPed[nI]["pedido"])
         EndIf
         If Len(aLote) == 900 .or. (nI == Len(aPed) .and. Len(aLote) > 0)
            EnvioLote(aLote, jZle)
            aLote := {}
         EndIf
      Next nI
   EndIf
   For nI := 1 to Len(aPed)
      aEnv := {}
      aN := aClone(aNfsAll[nI])
      If Len(aN) >= 2
         // mais antiga primeiro (emissao da NF, depois o numero)
         aSort(aN, , , {|x, y| x[3] + x[1] < y[3] + y[1]})
         aPed[nI]["nfPrincipal"] := aN[1][1]
         For nJ := 2 to Len(aN)
            cKey := aPed[nI]["pedido"] + "|" + aN[nJ][1] + "|" + aN[nJ][2]
            jZ := jZle[cKey]
            jE := JsonObject():New()
            jE["nf"]             := aN[nJ][1]
            jE["serie"]          := aN[nJ][2]
            jE["dataFat"]        := aN[nJ][3]
            jE["transportadoraNf"] := aN[nJ][4]
            jE["gravado"]        := ValType(jZ) == "J"
            jE["dataEnvio"]      := IIf(ValType(jZ) == "J", jZ["dataEnvio"], "")
            jE["dataPrevisao"]   := IIf(ValType(jZ) == "J", jZ["dataPrevisao"], "")
            jE["dataEntrega"]    := IIf(ValType(jZ) == "J", jZ["dataEntrega"], "")
            jE["tipoMaterial"]   := IIf(ValType(jZ) == "J", jZ["tipoMaterial"], "")
            jE["indicador"]      := IIf(ValType(jZ) == "J", jZ["indicador"], "")
            jE["transportadora"] := IIf(ValType(jZ) == "J" .and. !Empty(jZ["transportadora"]), jZ["transportadora"], aN[nJ][4])
            jE["usuario"]        := IIf(ValType(jZ) == "J", jZ["usuario"], "")
            jE["alteradoEm"]     := IIf(ValType(jZ) == "J", jZ["alteradoEm"], "")
            aAdd(aEnv, jE)
         Next nJ
      Else
         aPed[nI]["nfPrincipal"] := IIf(Len(aN) == 1, aN[1][1], "")
      EndIf
      aPed[nI]["envios"] := aEnv
   Next nI
Return Nil

// Linhas da ZLE de um lote de pedidos -> jZle["pedido|nf|serie"]
Static Function EnvioLote(aNums, jZle)
   Local cQuery := ""
   Local cAl    := ""
   Local oStmt  := Nil
   Local cIn    := ""
   Local jZ     := Nil
   Local nI     := 0
   For nI := 1 to Len(aNums)
      cIn += IIf(nI > 1, ",", "") + "?"
   Next nI
   cQuery := "SELECT ZLE_PEDIDO, ZLE_NF, ZLE_SERIE, ZLE_DTENV, ZLE_DTPREV, ZLE_DTENTR, ZLE_TPMAT, ZLE_INDICA, "
   cQuery += "       ZLE_TRANSP, ZLE_USUARI, ZLE_DTALT, ZLE_HRALT "
   cQuery += "FROM " + RetSqlName("ZLE") + " "
   cQuery += "WHERE ZLE_FILIAL = ? AND RTRIM(ZLE_PEDIDO) IN (" + cIn + ") AND D_E_L_E_T_ = ' ' "
   oStmt := FWExecStatement():New(cQuery)
   oStmt:SetString(1, FWxFilial("ZLE"))
   For nI := 1 to Len(aNums)
      oStmt:SetString(nI + 1, aNums[nI])
   Next nI
   cAl := oStmt:OpenAlias(GetNextAlias())
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         jZ := JsonObject():New()
         jZ["dataEnvio"]      := IsoOut((cAl)->ZLE_DTENV)
         jZ["dataPrevisao"]   := IsoOut((cAl)->ZLE_DTPREV)
         jZ["dataEntrega"]    := IsoOut((cAl)->ZLE_DTENTR)
         jZ["tipoMaterial"]   := AllTrim(SStr((cAl)->ZLE_TPMAT))
         jZ["indicador"]      := AllTrim(SStr((cAl)->ZLE_INDICA))
         jZ["transportadora"] := AllTrim(SStr((cAl)->ZLE_TRANSP))
         jZ["usuario"]        := TxtOut((cAl)->ZLE_USUARI)
         jZ["alteradoEm"]     := AllTrim(IsoOut((cAl)->ZLE_DTALT) + " " + AllTrim(SStr((cAl)->ZLE_HRALT)))
         jZle[AllTrim((cAl)->ZLE_PEDIDO) + "|" + AllTrim((cAl)->ZLE_NF) + "|" + AllTrim((cAl)->ZLE_SERIE)] := jZ
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return Nil

// ZLH existe e tem o ZLH_OBS (criado pelo usuario em 23/11/2026, fora do
// compatibilizador): conferido no ALL_TAB_COLUMNS, uma vez por chamada
Static Function TemObsRet()
Return TemTab("ZLH") .and. ("|ZLH_OBS|" $ ColunasDe("ZLH"))

// Expressao do ZLH_OBS na query, pelo tipo da coluna (memo real = BLOB/CLOB)
Static Function ObsZlhSql()
   Local cTipo := ""
   Local cAl   := GetNextAlias()
   Local oStmt := FWExecStatement():New("SELECT DATA_TYPE FROM ALL_TAB_COLUMNS WHERE " + LG_OWNER + " AND TABLE_NAME = ? AND COLUMN_NAME = 'ZLH_OBS'")
   oStmt:SetString(1, AllTrim(RetSqlName("ZLH")))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      cTipo := Upper(AllTrim((cAl)->DATA_TYPE))
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
   If cTipo == "BLOB"
      Return "NVL(UTL_RAW.CAST_TO_VARCHAR2(DBMS_LOB.SUBSTR(ZLH_OBS, 2000, 1)), ' ')"
   ElseIf cTipo == "CLOB" .or. cTipo == "NCLOB"
      Return "NVL(DBMS_LOB.SUBSTR(ZLH_OBS, 2000, 1), ' ')"
   EndIf
Return "ZLH_OBS"

// Campos do pedido que ficam na ZLH, nao na SC5 (pedido do usuario: nao criar
// mais campo na SC5). {chave do JSON, ZLH_CAMPO (ate 10), tipo, titulo (ate 30)}
// tipo: M texto livre, S sim (S ou vazio), D data, N valor, P outro pedido,
//       F motivo da finalizacao (FIN_MOTIVOS), R reembolso (FIN_REEMB)
Static Function CamposZlh()
   Local a := {}
   aAdd(a, {"obsRetorno",     "OBSRET",  "M", "Observacao do retorno"})
   aAdd(a, {"finalizado",     "FINALIZ", "S", "Finalizado sem entrega"})
   aAdd(a, {"motivoFinal",    "FINMOT",  "F", "Motivo da finalizacao"})
   aAdd(a, {"dataFinal",      "FINDATA", "D", "Data da finalizacao"})
   aAdd(a, {"pedidoFinal",    "FINPED",  "P", "Enviado no pedido"})
   aAdd(a, {"reembolso",      "REEMB",   "R", "Reembolso do extravio"})
   aAdd(a, {"valorReembolso", "REEMBVL", "N", "Valor do reembolso"})
   aAdd(a, {"dataReembolso",  "REEMBDT", "D", "Data do reembolso"})
   aAdd(a, {"obsFinal",       "FINOBS",  "M", "Observacao da finalizacao"})
   aAdd(a, {"obsIndicador",   "OBSIND",  "M", "Indicador: o que aconteceu"})
Return a

// Valor da tela -> valor cru gravado no ZLH_OBS ("" limpa). Erro em cErro.
Static Function ZlhIn(xV, cTipo, cPedido, cErro)
   Local cV   := ""
   Local dV   := CToD("")
   Local nV   := 0
   Local nTam := 0
   If cTipo == "S"
      If ValType(xV) == "L"
         Return IIf(xV, "S", "")
      EndIf
      cV := Upper(AllTrim(TxtIn(xV)))
      If cV $ "|S|SIM|"
         Return "S"
      ElseIf Empty(cV) .or. cV $ "|N|NAO|"
         Return ""
      EndIf
      cErro := "use S ou vazio."
      Return ""
   ElseIf cTipo == "D"
      cV := AllTrim(SStr(xV))
      dV := IsoIn(cV)
      If !Empty(cV) .and. Empty(dV)
         cErro := "data invalida (use AAAA-MM-DD)."
         Return ""
      EndIf
      Return IIf(Empty(dV), "", DToS(dV))
   ElseIf cTipo == "N"
      nV := NumIn(xV)
      If nV < 0
         cErro := "valor negativo."
         Return ""
      EndIf
      Return IIf(nV == 0, "", AllTrim(Str(nV, 16, 2)))
   ElseIf cTipo == "F" .or. cTipo == "R"
      cV := Upper(AllTrim(TxtIn(xV)))
      If !Empty(cV) .and. aScan(OpcoesBox(IIf(cTipo == "F", FIN_MOTIVOS, FIN_REEMB)), {|x| x[1] == cV}) == 0
         cErro := "opcao [" + cV + "] nao existe."
         Return ""
      EndIf
      Return cV
   ElseIf cTipo == "P"
      cV := Upper(AllTrim(TxtIn(xV)))
      nTam := TamSX3("C5_NUM")[1]
      If !Empty(cV) .and. Len(cV) < nTam .and. SoDigitos(cV)
         cV := PadL(cV, nTam, "0")
      EndIf
      If !Empty(cV) .and. cV == AllTrim(cPedido)
         cErro := "tem que ser outro pedido."
         Return ""
      EndIf
      If !Empty(cV) .and. !ExistePedido(cV)
         cErro := "pedido " + cV + " nao encontrado (SC5)."
         Return ""
      EndIf
      Return cV
   EndIf
   // texto livre: quebra de linha = CRLF no memo, espaco no campo caracter
   cV := AllTrim(TxtIn(xV))
   cV := StrTran(StrTran(cV, Chr(13) + Chr(10), Chr(10)), Chr(13), Chr(10))
   cV := StrTran(cV, Chr(10), IIf(TamSX3("ZLH_OBS")[3] == "M", Chr(13) + Chr(10), " "))
   If TamSX3("ZLH_OBS")[3] != "M" .and. Len(cV) > TamSX3("ZLH_OBS")[1]
      cErro := "texto com mais de " + cValToChar(TamSX3("ZLH_OBS")[1]) + " caracteres."
      Return ""
   EndIf
Return cV

// Valor cru do ZLH_OBS -> valor do JSON do GET
Static Function ZlhOut(cV, cTipo)
   If cTipo == "D"
      Return IsoOut(cV)
   ElseIf cTipo == "N"
      Return IIf(Empty(cV), 0, ValTxt(cV))
   EndIf
Return TxtOut(cV)

// Valor cru -> texto do historico (VALANT/VALNOV)
Static Function ZlhTxt(cV, cTipo)
   Local aOpc := {}
   Local nP   := 0
   If Empty(cV)
      Return ""
   ElseIf cTipo == "D"
      Return DToC(SToD(cV))
   ElseIf cTipo == "N"
      Return AllTrim(Transform(ValTxt(cV), "@E 999,999,999.99"))
   ElseIf cTipo == "S"
      Return "Sim"
   ElseIf cTipo == "F" .or. cTipo == "R"
      aOpc := OpcoesBox(IIf(cTipo == "F", FIN_MOTIVOS, FIN_REEMB))
      nP := aScan(aOpc, {|x| x[1] == cV})
      Return cV + IIf(nP > 0, " - " + aOpc[nP][2], "")
   EndIf
Return UmaLinha(cV)

// [[codigo, descricao], ...] de um combo fixo no fonte ("E=Extravio;...")
Static Function OpcoesBox(cBox)
   Local aRet := {}
   Local aOpc := StrTokArr(cBox, ";")
   Local nI   := 0
   Local nPos := 0
   For nI := 1 to Len(aOpc)
      nPos := At("=", aOpc[nI])
      If nPos > 0
         aAdd(aRet, {AllTrim(SubStr(aOpc[nI], 1, nPos - 1)), AllTrim(SubStr(aOpc[nI], nPos + 1))})
      EndIf
   Next nI
Return aRet

// Campos da ZLH de cada pedido = ZLH_OBS da linha mais recente de cada
// pedido+campo (sao poucas linhas: le todas as da filial). Sem a ZLH ou o
// ZLH_OBS: tudo vazio e "ZLH_OBS" em camposFaltando.
Static Function ValoresZlh(aPed, aFalta)
   Local aCz    := CamposZlh()
   Local jV     := JsonObject():New()
   Local cIn    := ""
   Local cQuery := ""
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   Local cK     := ""
   Local nI     := 0
   Local nJ     := 0
   Local lOk    := .F.
   If Len(aPed) == 0
      Return Nil
   EndIf
   lOk := TemObsRet()
   If !lOk
      aAdd(aFalta, "ZLH_OBS")
   Else
      cIn := ZlhCamposIn()
      cQuery := "SELECT ZLH_PEDIDO, ZLH_CAMPO, " + ObsZlhSql() + " AS OBS FROM " + RetSqlName("ZLH") + " "
      cQuery += "WHERE ZLH_FILIAL = ? AND ZLH_CAMPO IN (" + cIn + ") AND D_E_L_E_T_ = ' ' "
      cQuery += "ORDER BY ZLH_PEDIDO, ZLH_DATA, ZLH_HORA, R_E_C_N_O_ "
      oStmt := FWExecStatement():New(cQuery)
      oStmt:SetString(1, FWxFilial("ZLH"))
      cAl := oStmt:OpenAlias(cAl)
      If !Empty(cAl) .and. Select(cAl) > 0
         Do While !(cAl)->(Eof())
            jV[AllTrim((cAl)->ZLH_PEDIDO) + "|" + AllTrim((cAl)->ZLH_CAMPO)] := AllTrim(cValToChar((cAl)->OBS))
            (cAl)->(DbSkip())
         EndDo
         (cAl)->(DbCloseArea())
      EndIf
      oStmt:Destroy()
   EndIf
   For nI := 1 to Len(aPed)
      For nJ := 1 to Len(aCz)
         cK := aPed[nI]["pedido"] + "|" + aCz[nJ][2]
         aPed[nI][aCz[nJ][1]] := ZlhOut(IIf(lOk .and. ValType(jV[cK]) == "C", jV[cK], ""), aCz[nJ][3])
      Next nJ
   Next nI
Return Nil

// Valores crus gravados hoje para o pedido (linha mais recente de cada campo,
// sem acento convertido): para as regras, comparar e montar o historico
Static Function ZlhAtuais(cPedido)
   Local jRet   := JsonObject():New()
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   oStmt := FWExecStatement():New("SELECT ZLH_CAMPO, " + ObsZlhSql() + " AS OBS FROM " + RetSqlName("ZLH") + ;
      " WHERE ZLH_FILIAL = ? AND ZLH_PEDIDO = ? AND ZLH_CAMPO IN (" + ZlhCamposIn() + ") AND D_E_L_E_T_ = ' ' " + ;
      "ORDER BY ZLH_DATA, ZLH_HORA, R_E_C_N_O_")
   oStmt:SetString(1, FWxFilial("ZLH"))
   oStmt:SetString(2, cPedido)
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         jRet[AllTrim((cAl)->ZLH_CAMPO)] := AllTrim(cValToChar((cAl)->OBS))
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return jRet

// "'OBSRET','FINALIZ',..." para o IN das consultas
Static Function ZlhCamposIn()
   Local aCz := CamposZlh()
   Local cIn := ""
   Local nI  := 0
   For nI := 1 to Len(aCz)
      cIn += IIf(nI > 1, ",", "") + "'" + aCz[nI][2] + "'"
   Next nI
Return cIn

// Valor final de um campo da ZLH: o que veio no corpo, senao o gravado
Static Function ZlhFinal(aZlh, jAtu, cCampo)
   Local nP := aScan(aZlh, {|x| x[1] == cCampo})
   If nP > 0
      Return aZlh[nP][4]
   EndIf
Return IIf(ValType(jAtu[cCampo]) == "C", jAtu[cCampo], "")

// Texto numa linha so (quebras viram espaco), para o resumo do historico
Static Function UmaLinha(cTxt)
Return AllTrim(StrTran(StrTran(StrTran(cTxt, Chr(13) + Chr(10), " "), Chr(13), " "), Chr(10), " "))

// Uma linha na ZLH para um campo que fica nela: valor cru no ZLH_OBS;
// antes/depois legiveis (VALANT/VALNOV) para o historico da tela. Erro volta
// como aviso (a SC5 ja foi gravada).
Static Function GravaZlh(cPedido, cCampo, cTitulo, cTipo, cAnt, cNova, cOrigem)
   Local cErro  := ""
   Local oErr   := Nil
   Local aU     := UsrInfo()
   Local bErrAn := ErrorBlock({|oE| Break(oE) })
   Local cAcao  := IIf(Empty(cAnt), "I", IIf(Empty(cNova), "E", "A"))
   Begin Sequence
      DbSelectArea("ZLH")
      RecLock("ZLH", .T.)
      ZLH->ZLH_FILIAL := FWxFilial("ZLH")
      ZLH->ZLH_PEDIDO := cPedido
      ZLH->ZLH_ITEM   := ""
      ZLH->ZLH_DATA   := Date()
      ZLH->ZLH_HORA   := Time()
      ZLH->ZLH_ACAO   := cAcao
      ZLH->ZLH_ORIGEM := cOrigem
      ZLH->ZLH_CAMPO  := cCampo
      ZLH->ZLH_TITULO := Left(cTitulo, TamSX3("ZLH_TITULO")[1])
      ZLH->ZLH_VALANT := Left(ZlhTxt(cAnt, cTipo), TamSX3("ZLH_VALANT")[1])
      ZLH->ZLH_VALNOV := Left(ZlhTxt(cNova, cTipo), TamSX3("ZLH_VALNOV")[1])
      ZLH->ZLH_OBS    := cNova
      ZLH->ZLH_CODUSR := aU[1]
      ZLH->ZLH_USUARI := aU[2]
      ZLH->(MsUnlock())
   Recover Using oErr
      cErro := "Gravado, mas " + cTitulo + " falhou: " + TxtErro(oErr) + " "
   End Sequence
   ErrorBlock(bErrAn)
Return cErro

// Numeros de serie da Z01 (como o RX Pedidos): em cada item, "numerosSerie" =
// [[serie, nf], ...], com e sem NF. Lotes de 900 pedidos (limite do IN do
// Oracle). A Z01 e as colunas sao conferidas antes: tabela ou coluna que nao
// existe derruba a thread do REST sem passar pelo Recover.
Static Function NumerosSerie(aPed, aFalta)
   Local jSer   := JsonObject():New()
   Local aLote  := {}
   Local aVazio := {}
   Local cKey   := ""
   Local nI     := 0
   Local nJ     := 0
   Local aIt    := {}

   If Len(aPed) == 0
      Return Nil
   EndIf
   If !TemZ01()
      aAdd(aFalta, "Z01")
      Return Nil
   EndIf
   For nI := 1 to Len(aPed)
      aAdd(aLote, aPed[nI]["pedido"])
      If Len(aLote) == 900 .or. nI == Len(aPed)
         SerieLote(aLote, jSer)
         aLote := {}
      EndIf
   Next nI
   For nI := 1 to Len(aPed)
      aIt := aPed[nI]["itens"]
      For nJ := 1 to Len(aIt)
         cKey := aPed[nI]["pedido"] + "|" + aIt[nJ]["item"]
         If ValType(jSer[cKey]) == "A"
            aIt[nJ]["numerosSerie"] := jSer[cKey]
         Else
            aVazio := {}
            aIt[nJ]["numerosSerie"] := aVazio
         EndIf
      Next nJ
   Next nI
Return Nil

Static Function TemZ01()
   Local cAl   := GetNextAlias()
   Local oStmt := Nil
   Local nCols := 0
   oStmt := FWExecStatement():New("SELECT COUNT(*) AS QTD FROM ALL_TAB_COLUMNS WHERE " + LG_OWNER + " AND TABLE_NAME = ? " + ;
      "AND COLUMN_NAME IN ('Z01_FILIAL','Z01_PEDIDO','Z01_ITEM','Z01_SERIE','Z01_NFEDO','D_E_L_E_T_')")
   oStmt:SetString(1, AllTrim(RetSqlName("Z01")))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      nCols := NNum((cAl)->QTD)
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return nCols == 6

Static Function SerieLote(aNums, jSer)
   Local cQuery := ""
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   Local cIn    := ""
   Local cKey   := ""
   Local aSer   := {}
   Local nI     := 0

   For nI := 1 to Len(aNums)
      cIn += IIf(nI > 1, ",", "") + "?"
   Next nI
   cQuery := "SELECT Z01_PEDIDO, Z01_ITEM, Z01_SERIE, Z01_NFEDO FROM " + RetSqlName("Z01") + " "
   cQuery += "WHERE RTRIM(Z01_PEDIDO) IN (" + cIn + ") AND Z01_SERIE <> ' ' "
   cQuery += "  AND (Z01_FILIAL = ' ' OR Z01_FILIAL = ?) AND D_E_L_E_T_ = ' ' "
   cQuery += "ORDER BY Z01_PEDIDO, Z01_ITEM, Z01_SERIE "

   oStmt := FWExecStatement():New(cQuery)
   For nI := 1 to Len(aNums)
      oStmt:SetString(nI, aNums[nI])
   Next nI
   oStmt:SetString(Len(aNums) + 1, FWxFilial("SC6"))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         cKey := AllTrim((cAl)->Z01_PEDIDO) + "|" + AllTrim((cAl)->Z01_ITEM)
         // o array do JsonObject pode vir copiado: monta e grava de volta
         aSer := IIf(ValType(jSer[cKey]) == "A", jSer[cKey], {})
         aAdd(aSer, {TxtOut((cAl)->Z01_SERIE), AllTrim(SStr((cAl)->Z01_NFEDO))})
         jSer[cKey] := aSer
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return Nil

Static Function FechaPedido(jPed, aItens, aNotas, cDtFat)
   jPed["itens"]       := aItens
   jPed["notas"]       := aNotas
   jPed["dataFaturamento"] := cDtFat
Return

// "(11) 3333-4444" do DDD e do telefone do cadastro (sem DDD repetido)
Static Function Fone(xDdd, xTel)
   Local cDdd := AllTrim(SStr(xDdd))
   Local cTel := AllTrim(SStr(xTel))
   If Empty(cTel)
      Return ""
   EndIf
   If !Empty(cDdd) .and. !(Left(cTel, 1) == "(") .and. !(Left(cTel, Len(cDdd)) == cDdd)
      cTel := "(" + cDdd + ") " + cTel
   EndIf
Return TxtOut(cTel)

// "SC5.C5_X AS APELIDO" se o campo existe; senao "' ' AS APELIDO" e anota em aFalta
Static Function ColOpc(cExist, cCampo, cApelido, aFalta)
   If ("|" + cCampo + "|") $ cExist
      Return "SC5." + cCampo + " AS " + cApelido
   EndIf
   aAdd(aFalta, cCampo)
Return "' ' AS " + cApelido

// Coluna do endereco do cliente de entrega: SA2 (SFE) na devolucao/beneficiamento,
// SA1 (SAE) nos outros. Coluna que nao existe no cadastro vira ' ' (coluna
// inexistente derruba a thread do REST). cSufixo = END, COMPLEM, BAIRRO, CEP.
Static Function EndCol(cExA1, cExA2, cSufixo, cApelido)
   Local cA1 := IIf(("|A1_" + cSufixo + "|") $ cExA1, "SAE.A1_" + cSufixo, "' '")
   Local cA2 := IIf(("|A2_" + cSufixo + "|") $ cExA2, "SFE.A2_" + cSufixo, "' '")
Return "CASE WHEN SC5.C5_TIPO IN ('D','B') THEN " + cA2 + " ELSE " + cA1 + " END AS " + cApelido

// Campo de texto livre da SC5 na query, pelo tipo da coluna no Oracle: memo
// real fica em BLOB/CLOB e nao sai direto num SELECT (2026-11-15b). Usado no
// C5_ZOBS e no C5_MENNOTA (2026-11-23a). Campo que nao existe
// vira ' ' e entra em aFalta.
Static Function ObsSql(cExist, aFalta, cCampo)
   Local cTipo := ""
   Local cAl   := GetNextAlias()
   Local oStmt := Nil
   If !(("|" + cCampo + "|") $ cExist)
      aAdd(aFalta, cCampo)
      Return "' '"
   EndIf
   oStmt := FWExecStatement():New("SELECT DATA_TYPE FROM ALL_TAB_COLUMNS WHERE " + LG_OWNER + " AND TABLE_NAME = ? AND COLUMN_NAME = ?")
   oStmt:SetString(1, AllTrim(RetSqlName("SC5")))
   oStmt:SetString(2, cCampo)
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      cTipo := Upper(AllTrim((cAl)->DATA_TYPE))
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
   If cTipo == "BLOB"
      Return "NVL(UTL_RAW.CAST_TO_VARCHAR2(DBMS_LOB.SUBSTR(SC5." + cCampo + ", 2000, 1)), ' ')"
   ElseIf cTipo == "CLOB" .or. cTipo == "NCLOB"
      Return "NVL(DBMS_LOB.SUBSTR(SC5." + cCampo + ", 2000, 1), ' ')"
   EndIf
Return "SC5." + cCampo

// "|C5_X|C5_Y|..." com as colunas fisicas da SC5 (ALL_TAB_COLUMNS)
Static Function ColunasExistentes()
Return ColunasDe("SC5")

// "|X_A|X_B|..." com as colunas fisicas da tabela do alias (ALL_TAB_COLUMNS)
Static Function ColunasDe(cAliasTab)
   Local cRet  := "|"
   Local cAl   := GetNextAlias()
   Local oStmt := FWExecStatement():New("SELECT COLUMN_NAME FROM ALL_TAB_COLUMNS WHERE " + LG_OWNER + " AND TABLE_NAME = ?")
   oStmt:SetString(1, AllTrim(RetSqlName(cAliasTab)))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         cRet += AllTrim((cAl)->COLUMN_NAME) + "|"
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return cRet

// [[codigo, descricao], ...] do X3_CBOX (ex.: "T=Terminal;P=Periferico")
Static Function OpcoesCombo(cCampo)
   Local aRet  := {}
   Local cBox  := ""
   Local aOpc  := {}
   Local nI    := 0
   Local nPos  := 0
   cBox := AllTrim(SStr(GetSX3Cache(cCampo, "X3_CBOX")))
   If Empty(cBox)
      Return aRet
   EndIf
   aOpc := StrTokArr(cBox, ";")
   For nI := 1 to Len(aOpc)
      nPos := At("=", aOpc[nI])
      If nPos > 0
         aAdd(aRet, {AllTrim(SubStr(aOpc[nI], 1, nPos - 1)), TxtOut(AllTrim(SubStr(aOpc[nI], nPos + 1)))})
      EndIf
   Next nI
Return aRet

Static Function CodigoNoCombo(cCampo, cCod)
   Local aOpc := OpcoesCombo(cCampo)
   If Len(aOpc) == 0
      Return .T.
   EndIf
Return aScan(aOpc, {|x| x[1] == cCod}) > 0

// Valor gravado no campo SIM/NAO conforme o combo do SX3 ("S=Sim;N=Nao" ou
// "1=Sim;2=Nao"): opcao cujo texto comeca com S (sim) ou N (nao). Sem combo,
// grava o proprio S/N. Vazio limpa o campo. (mesma regra do RESTPCPREL)
Static Function ValorSimNao(cCampo, cSN)
   Local cBox  := ""
   Local aOpc  := {}
   Local nI    := 0
   Local nPos  := 0
   If Empty(cSN)
      Return ""
   EndIf
   cBox := AllTrim(SStr(GetSX3Cache(cCampo, "X3_CBOX")))
   If Empty(cBox)
      Return cSN
   EndIf
   aOpc := StrTokArr(cBox, ";")
   For nI := 1 to Len(aOpc)
      nPos := At("=", aOpc[nI])
      If nPos > 0 .and. Upper(SubStr(AllTrim(SubStr(aOpc[nI], nPos + 1)), 1, 1)) == cSN
         Return AllTrim(SubStr(aOpc[nI], 1, nPos - 1))
      EndIf
   Next nI
Return cSN

// Tamanho dos campos de texto (a tela limita a digitacao)
Static Function Tamanhos()
   Local jT    := JsonObject():New()
   Local aCpos := {"C5_ZCTE", "C5_ZCTEREE", "C5_ZFRETE", "C5_TRANSP", "C5_ESPECI1", "C5_ZOBS"}
   Local nI    := 0
   DbSelectArea("SC5")
   For nI := 1 to Len(aCpos)
      // memo (C5_ZOBS pode ser) nao tem tamanho: a tela nao limita
      If SC5->(FieldPos(aCpos[nI])) > 0 .and. TamSX3(aCpos[nI])[3] != "M"
         jT[aCpos[nI]] := TamSX3(aCpos[nI])[1]
      EndIf
   Next nI
   // observacao do retorno (ZLH_OBS): limite so se for caracter
   If TemObsRet() .and. TamSX3("ZLH_OBS")[3] != "M"
      jT["ZLH_OBS"] := TamSX3("ZLH_OBS")[1]
   EndIf
Return jT

// [[codigo, nome], ...] da SA4
Static Function Transportadoras()
   Local aRet   := {}
   Local cQuery := ""
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   cQuery := "SELECT A4_COD, A4_NOME FROM " + RetSqlName("SA4") + " "
   cQuery += "WHERE (A4_FILIAL = ? OR A4_FILIAL = ' ') AND D_E_L_E_T_ = ' ' ORDER BY A4_NOME "
   oStmt := FWExecStatement():New(cQuery)
   oStmt:SetString(1, FWxFilial("SA4"))
   cAl := oStmt:OpenAlias(cAl)
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         aAdd(aRet, {AllTrim((cAl)->A4_COD), TxtOut((cAl)->A4_NOME)})
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return aRet

// ----------------------------------------------------------------------------
// Custos de frete (ZLC) e historico (ZLH) - 2026-11-19a
// ----------------------------------------------------------------------------

/*/{Protheus.doc} postVsLogCusto
Inclui, altera ou exclui (logico) uma cobranca de frete do pedido (ZLC) e grava
o historico (ZLH). Responde o pedido no formato do GET.
@type function
@author Romulo Garcia
@since 19/11/2026
@body {"recno": 123, "acao": "incluir"|"alterar"|"excluir", "item": "001", "tipo": "E", "cte": "...", "data": "AAAA-MM-DD", "transportadora": "000001", "valor": 0, "valorEsperado": 0, "situacao": "D", "obs": "..."}
/*/
@Post("/api/v1/vs-financial-data/logistica/custos")
User Function postVsLogCusto() as Logical
Return GravaCusto()

Static Function GravaCusto()
   Local jBody       := JsonObject():New()
   Local jRet        := Nil
   Local xErrJson    := Nil
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local lTravou     := .F.
   Local nRecno      := 0
   Local cAcao       := ""
   Local cItem       := ""
   Local cPedido     := ""
   Local cOrigem     := "1"
   Local aVal        := {}
   Local aHist       := {}
   Local cTxt        := ""
   Local xVal        := Nil
   Local xAnt        := Nil
   Local nI          := 0
   Local nPos        := 0
   Local lHis        := .F.
   Local aPed        := {}
   Local aIgnora     := {}
   Local cAlAberto   := ""
   Local cAvisoH     := ""
   Local cResumo     := ""
   Local cHA         := ""
   Local cHN         := ""

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      cEtapa := "01-parametros"
      xErrJson := jBody:FromJson(SStr(oRest:getBodyRequest()))
      If ValType(xErrJson) == "C"
         jRet := BuildErro(400, "JSON_INVALIDO", "Corpo da requisicao nao e um JSON valido.")
         lRespondido := .T.
         Break
      EndIf
      nRecno := NNum(jBody["recno"])
      cAcao  := Lower(AllTrim(SStr(jBody["acao"])))
      If aScan({"incluir", "alterar", "excluir"}, cAcao) == 0
         jRet := BuildErro(400, "ACAO_INVALIDA", "acao deve ser incluir, alterar ou excluir.")
         lRespondido := .T.
         Break
      EndIf
      If ValType(jBody["item"]) == "N"
         cItem := StrZero(jBody["item"], 3)
      Else
         cItem := AllTrim(SStr(jBody["item"]))
      EndIf
      If Upper(AllTrim(SStr(jBody["origem"]))) == "IMPORTACAO"
         cOrigem := "2"
      EndIf

      cEtapa := "02-pedido"
      If !TemTab("ZLC")
         jRet := BuildErro(409, "SEM_TABELA_CUSTOS", "Tabela de custos de frete (ZLC) nao criada neste ambiente: rodar o U_LOGRELUPD, opcao Tabelas.")
         lRespondido := .T.
         Break
      EndIf
      lHis := TemTab("ZLH")
      If nRecno <= 0
         jRet := BuildErro(400, "RECNO_INVALIDO", "Informe o recno do pedido.")
         lRespondido := .T.
         Break
      EndIf
      DbSelectArea("SC5")
      SC5->(DbGoTo(nRecno))
      If SC5->(Eof()) .or. SC5->(Deleted()) .or. SC5->C5_FILIAL != FWxFilial("SC5")
         jRet := BuildErro(404, "PEDIDO_NAO_ENCONTRADO", "Pedido nao encontrado (excluido ou de outra filial).")
         lRespondido := .T.
         Break
      EndIf
      cPedido := SC5->C5_NUM

      cEtapa := "03-campos"
      If cAcao != "excluir"
         If jBody:HasProperty("tipo")
            cTxt := Upper(AllTrim(TxtIn(jBody["tipo"])))
            If Empty(cTxt) .or. !CodigoNoCombo("ZLC_TIPO", cTxt)
               jRet := BuildErro(400, "TIPO_INVALIDO", "Tipo da cobranca [" + cTxt + "] nao existe no combo do ZLC_TIPO.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_TIPO", cTxt})
         ElseIf cAcao == "incluir"
            jRet := BuildErro(400, "TIPO_OBRIGATORIO", "Informe o tipo da cobranca.")
            lRespondido := .T.
            Break
         EndIf
         If jBody:HasProperty("cte")
            cTxt := AllTrim(TxtIn(jBody["cte"]))
            If Len(cTxt) > TamSX3("ZLC_CTE")[1]
               jRet := BuildErro(400, "TEXTO_GRANDE", "CTE com mais de " + cValToChar(TamSX3("ZLC_CTE")[1]) + " caracteres.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_CTE", cTxt})
         EndIf
         If jBody:HasProperty("data")
            cTxt := AllTrim(SStr(jBody["data"]))
            xVal := IsoIn(cTxt)
            If !Empty(cTxt) .and. Empty(xVal)
               jRet := BuildErro(400, "DATA_INVALIDA", "data: data invalida (use AAAA-MM-DD).")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_DATA", xVal})
         EndIf
         If jBody:HasProperty("transportadora")
            cTxt := Upper(AllTrim(TxtIn(jBody["transportadora"])))
            If !Empty(cTxt) .and. !ExisteTransp(cTxt)
               jRet := BuildErro(400, "TRANSPORTADORA_INVALIDA", "Transportadora " + cTxt + " nao cadastrada (SA4).")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_TRANSP", cTxt})
         EndIf
         If jBody:HasProperty("valor")
            xVal := NumIn(jBody["valor"])
            If xVal < 0
               jRet := BuildErro(400, "VALOR_INVALIDO", "valor negativo.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_VALOR", Round(xVal, 2)})
         EndIf
         If jBody:HasProperty("valorEsperado")
            xVal := NumIn(jBody["valorEsperado"])
            If xVal < 0
               jRet := BuildErro(400, "VALOR_INVALIDO", "valorEsperado negativo.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_VLRESP", Round(xVal, 2)})
         EndIf
         If jBody:HasProperty("situacao")
            cTxt := Upper(AllTrim(TxtIn(jBody["situacao"])))
            If !Empty(cTxt) .and. !CodigoNoCombo("ZLC_SITUA", cTxt)
               jRet := BuildErro(400, "SITUACAO_INVALIDA", "Situacao [" + cTxt + "] nao existe no combo do ZLC_SITUA.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_SITUA", cTxt})
         EndIf
         If jBody:HasProperty("obs")
            // campo caracter: quebra de linha vira espaco
            cTxt := TxtIn(jBody["obs"])
            cTxt := AllTrim(StrTran(StrTran(StrTran(cTxt, Chr(13) + Chr(10), " "), Chr(13), " "), Chr(10), " "))
            If Len(cTxt) > TamSX3("ZLC_OBS")[1]
               jRet := BuildErro(400, "TEXTO_GRANDE", "Observacao com mais de " + cValToChar(TamSX3("ZLC_OBS")[1]) + " caracteres.")
               lRespondido := .T.
               Break
            EndIf
            aAdd(aVal, {"ZLC_OBS", cTxt})
         EndIf
         // NF do envio (2026-11-25a): vazio = envio principal; senao, NF do pedido
         If jBody:HasProperty("nf")
            cTxt := AllTrim(TxtIn(jBody["nf"]))
            If !("|ZLC_NF|" $ ColunasDe("ZLC"))
               If !Empty(cTxt)
                  jRet := BuildErro(400, "CAMPO_INEXISTENTE", "Campo ZLC_NF ainda nao criado: rodar o U_LOGRELUPD, opcao Tabelas.")
                  lRespondido := .T.
                  Break
               EndIf
            Else
               If !Empty(cTxt) .and. Empty(NfDoPedido(cPedido, cTxt, "")[1])
                  jRet := BuildErro(400, "NF_NAO_E_DO_PEDIDO", "A NF " + cTxt + " nao e do pedido " + AllTrim(cPedido) + ".")
                  lRespondido := .T.
                  Break
               EndIf
               aAdd(aVal, {"ZLC_NF", cTxt})
            EndIf
         EndIf
         If cAcao == "incluir" .and. ValorDe(aVal, "ZLC_VALOR", 0) <= 0 .and. Empty(ValorDe(aVal, "ZLC_CTE", ""))
            jRet := BuildErro(400, "SEM_VALOR", "Informe o valor ou o numero do CTE/documento.")
            lRespondido := .T.
            Break
         EndIf
      EndIf

      cEtapa := "04-registro"
      DbSelectArea("ZLC")
      ZLC->(DbSetOrder(1)) // ZLC_FILIAL+ZLC_PEDIDO+ZLC_ITEM
      If cAcao != "incluir"
         If Empty(cItem) .or. !ZLC->(DbSeek(FWxFilial("ZLC") + PadR(cPedido, TamSX3("ZLC_PEDIDO")[1]) + PadR(cItem, TamSX3("ZLC_ITEM")[1])))
            jRet := BuildErro(404, "COBRANCA_NAO_ENCONTRADA", "Cobranca " + cItem + " do pedido " + AllTrim(cPedido) + " nao encontrada (ja excluida?).")
            lRespondido := .T.
            Break
         EndIf
      EndIf

      cEtapa := "05-gravacao"
      If cAcao == "incluir"
         cItem := ProxItem(cPedido)
         RecLock("ZLC", .T.)
         lTravou := .T.
         ZLC->ZLC_FILIAL := FWxFilial("ZLC")
         ZLC->ZLC_PEDIDO := cPedido
         ZLC->ZLC_ITEM   := cItem
         // sem transportadora no corpo: a do pedido
         ZLC->ZLC_TRANSP := SC5->C5_TRANSP
         For nI := 1 to Len(aVal)
            ZLC->(FieldPut(ZLC->(FieldPos(aVal[nI][1])), aVal[nI][2]))
         Next nI
         Carimbo()
         cResumo := ResumoCusto()
         ZLC->(MsUnlock())
         lTravou := .F.
         aAdd(aHist, {cItem, "I", "ZLC", "Cobranca incluida", "", cResumo})
      ElseIf cAcao == "alterar"
         cItem := ZLC->ZLC_ITEM
         If !RecLock("ZLC", .F.)
            jRet := BuildErro(409, "COBRANCA_EM_USO", "Cobranca em uso por outro usuario. Tente de novo.")
            lRespondido := .T.
            Break
         EndIf
         lTravou := .T.
         For nI := 1 to Len(aVal)
            nPos := ZLC->(FieldPos(aVal[nI][1]))
            xAnt := ZLC->(FieldGet(nPos))
            cHA  := HistTxt(xAnt, aVal[nI][1])
            cHN  := HistTxt(aVal[nI][2], aVal[nI][1])
            If !(cHA == cHN)
               aAdd(aHist, {cItem, "A", aVal[nI][1], TituloCampo(aVal[nI][1]), cHA, cHN})
            EndIf
            ZLC->(FieldPut(nPos, aVal[nI][2]))
         Next nI
         If Len(aHist) > 0
            Carimbo()
         EndIf
         ZLC->(MsUnlock())
         lTravou := .F.
      Else
         cItem   := ZLC->ZLC_ITEM
         cResumo := ResumoCusto()
         If !RecLock("ZLC", .F.)
            jRet := BuildErro(409, "COBRANCA_EM_USO", "Cobranca em uso por outro usuario. Tente de novo.")
            lRespondido := .T.
            Break
         EndIf
         lTravou := .T.
         // quem excluiu fica na propria linha (exclusao logica) e no historico
         Carimbo()
         ZLC->(DbDelete())
         ZLC->(MsUnlock())
         lTravou := .F.
         aAdd(aHist, {cItem, "E", "ZLC", "Cobranca excluida", cResumo, ""})
      EndIf

      cEtapa := "05b-historico"
      If lHis .and. Len(aHist) > 0
         cAvisoH := GravaHists(cPedido, aHist, cOrigem)
      EndIf

      cEtapa := "06-resposta"
      aPed := ConsultaPedidos(CToD(""), CToD(""), {cPedido}, @aIgnora, @cEtapa, @cAlAberto)
      If Len(aPed) > 0
         aPed[1]["itemCusto"] := AllTrim(cItem)
         If !Empty(cAvisoH)
            aPed[1]["avisoHistorico"] := TxtOut(cAvisoH)
         EndIf
         jRet := oRest:setStatusResponse(200, aPed[1]:ToJson())
      Else
         jRet := oRest:setStatusResponse(200, '{"recno":' + cValToChar(nRecno) + ',"aviso":"gravado"}')
      EndIf
      lRespondido := .T.

   Recover Using oErrCap
      If lTravou
         ZLC->(MsUnlock())
      EndIf
      If !Empty(cAlAberto) .and. Select(cAlAberto) > 0
         (cAlAberto)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

// ----------------------------------------------------------------------------
// Envios parciais (ZLE) - 2026-11-25a
// ----------------------------------------------------------------------------

/*/{Protheus.doc} postVsLogEnvio
Grava (inclui ou altera) o envio de uma NF do pedido que nao e a principal (ZLE)
e o historico (ZLH). Campo ausente nao altera; vazio limpa. Responde o pedido
no formato do GET.
@type function
@author Romulo Garcia
@since 25/11/2026
@body {"recno": 123, "nf": "000001234", "serie": "1", "dataEnvio": "AAAA-MM-DD", "dataPrevisao": "...", "dataEntrega": "...", "tipoMaterial": "T", "indicador": "1", "transportadora": "000001"}
/*/
@Post("/api/v1/vs-financial-data/logistica/envios")
User Function postVsLogEnvio() as Logical
Return GravaEnvio()

// {chave do JSON, campo da ZLE, tipo (D data, B combo, T transportadora), combo da SC5, titulo}
Static Function MapaEnvio()
Return { ;
   {"dataEnvio", "ZLE_DTENV", "D", "", "Data de envio"}, ;
   {"dataPrevisao", "ZLE_DTPREV", "D", "", "Previsao de entrega"}, ;
   {"dataEntrega", "ZLE_DTENTR", "D", "", "Data de entrega"}, ;
   {"tipoMaterial", "ZLE_TPMAT", "B", "C5_ZTPMAT", "Tipo de material"}, ;
   {"indicador", "ZLE_INDICA", "B", "C5_ZINDICA", "Indicador de atraso"}, ;
   {"transportadora", "ZLE_TRANSP", "T", "", "Transportadora"}}

// {emissao da NF, transportadora da NF} se a NF/serie e do pedido; senao {CToD(""), ""}.
// Serie vazia = qualquer serie.
Static Function NfDoPedido(cPedido, cNf, cSerie)
   Local aRet   := {CToD(""), ""}
   Local cQuery := ""
   Local cAl    := ""
   Local oStmt  := Nil
   cQuery := "SELECT MIN(SF2.F2_EMISSAO) AS DTFAT, MAX(SF2.F2_TRANSP) AS TRANSP, COUNT(*) AS QTD "
   cQuery += "FROM " + RetSqlName("SC6") + " SC6 "
   cQuery += "LEFT JOIN " + RetSqlName("SF2") + " SF2 ON (SF2.F2_FILIAL = '" + FWxFilial("SF2") + "' OR SF2.F2_FILIAL = ' ') "
   cQuery += "    AND SF2.F2_DOC = SC6.C6_NOTA AND SF2.F2_SERIE = SC6.C6_SERIE AND SF2.D_E_L_E_T_ = ' ' "
   cQuery += "WHERE SC6.C6_FILIAL = ? AND SC6.C6_NUM = ? AND RTRIM(SC6.C6_NOTA) = ? AND SC6.D_E_L_E_T_ = ' ' "
   If !Empty(cSerie)
      cQuery += "  AND RTRIM(SC6.C6_SERIE) = ? "
   EndIf
   oStmt := FWExecStatement():New(cQuery)
   oStmt:SetString(1, FWxFilial("SC6"))
   oStmt:SetString(2, PadR(cPedido, TamSX3("C5_NUM")[1]))
   oStmt:SetString(3, AllTrim(cNf))
   If !Empty(cSerie)
      oStmt:SetString(4, AllTrim(cSerie))
   EndIf
   cAl := oStmt:OpenAlias(GetNextAlias())
   If !Empty(cAl) .and. Select(cAl) > 0
      If NNum((cAl)->QTD) > 0
         aRet := {IIf(ValType((cAl)->DTFAT) == "D", (cAl)->DTFAT, SToD(AllTrim(SStr((cAl)->DTFAT)))), AllTrim(SStr((cAl)->TRANSP))}
         If Empty(aRet[1])
            aRet[1] := SToD("19000101")
         EndIf
      EndIf
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return aRet

Static Function GravaEnvio()
   Local jBody       := JsonObject():New()
   Local jRet        := Nil
   Local xErrJson    := Nil
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local lTravou     := .F.
   Local nRecno      := 0
   Local cPedido     := ""
   Local cNf         := ""
   Local cSerie      := ""
   Local cOrigem     := "1"
   Local aNfInfo     := {}
   Local aMapa       := MapaEnvio()
   Local aVal        := {}
   Local aHist       := {}
   Local cTxt        := ""
   Local xVal        := Nil
   Local xAnt        := Nil
   Local nI          := 0
   Local nPos        := 0
   Local lHis        := .F.
   Local lNovo       := .F.
   Local dEnv        := CToD("")
   Local dEnt        := CToD("")
   Local cChave      := ""
   Local aU          := {}
   Local aPed        := {}
   Local aIgnora     := {}
   Local cAlAberto   := ""
   Local cAvisoH     := ""
   Local cHA         := ""
   Local cHN         := ""
   Local cTit        := ""

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      cEtapa := "01-parametros"
      xErrJson := jBody:FromJson(SStr(oRest:getBodyRequest()))
      If ValType(xErrJson) == "C"
         jRet := BuildErro(400, "JSON_INVALIDO", "Corpo da requisicao nao e um JSON valido.")
         lRespondido := .T.
         Break
      EndIf
      nRecno := NNum(jBody["recno"])
      cNf    := AllTrim(TxtIn(jBody["nf"]))
      cSerie := AllTrim(TxtIn(jBody["serie"]))
      If Upper(AllTrim(SStr(jBody["origem"]))) == "IMPORTACAO"
         cOrigem := "2"
      EndIf
      If nRecno <= 0 .or. Empty(cNf)
         jRet := BuildErro(400, "PARAMETROS", "Informe o recno do pedido e a NF do envio.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "02-pedido"
      If !TemTab("ZLE")
         jRet := BuildErro(409, "SEM_TABELA_ENVIOS", "Tabela de envios (ZLE) nao criada neste ambiente: rodar o U_LOGRELUPD, opcao Tabelas.")
         lRespondido := .T.
         Break
      EndIf
      lHis := TemTab("ZLH")
      DbSelectArea("SC5")
      SC5->(DbGoTo(nRecno))
      If SC5->(Eof()) .or. SC5->(Deleted()) .or. SC5->C5_FILIAL != FWxFilial("SC5")
         jRet := BuildErro(404, "PEDIDO_NAO_ENCONTRADO", "Pedido nao encontrado (excluido ou de outra filial).")
         lRespondido := .T.
         Break
      EndIf
      cPedido := SC5->C5_NUM
      aNfInfo := NfDoPedido(cPedido, cNf, cSerie)
      If Empty(aNfInfo[1])
         jRet := BuildErro(400, "NF_NAO_E_DO_PEDIDO", "A NF " + cNf + IIf(Empty(cSerie), "", "/" + cSerie) + " nao e do pedido " + AllTrim(cPedido) + ".")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "03-campos"
      For nI := 1 to Len(aMapa)
         If !jBody:HasProperty(aMapa[nI][1])
            Loop
         EndIf
         If aMapa[nI][3] == "D"
            cTxt := AllTrim(SStr(jBody[aMapa[nI][1]]))
            xVal := IsoIn(cTxt)
            If !Empty(cTxt) .and. Empty(xVal)
               jRet := BuildErro(400, "DATA_INVALIDA", aMapa[nI][1] + ": data invalida (use AAAA-MM-DD).")
               lRespondido := .T.
               Break
            EndIf
         ElseIf aMapa[nI][3] == "B"
            xVal := AllTrim(TxtIn(jBody[aMapa[nI][1]]))
            If !Empty(xVal) .and. !CodigoNoCombo(aMapa[nI][4], xVal)
               jRet := BuildErro(400, "OPCAO_INVALIDA", aMapa[nI][1] + ": opcao [" + xVal + "] nao existe no combo do " + aMapa[nI][4] + ".")
               lRespondido := .T.
               Break
            EndIf
         Else
            xVal := Upper(AllTrim(TxtIn(jBody[aMapa[nI][1]])))
            If !Empty(xVal) .and. !ExisteTransp(xVal)
               jRet := BuildErro(400, "TRANSPORTADORA_INVALIDA", "Transportadora " + xVal + " nao cadastrada (SA4).")
               lRespondido := .T.
               Break
            EndIf
         EndIf
         aAdd(aVal, {aMapa[nI][2], xVal, aMapa[nI][5]})
      Next nI
      If Len(aVal) == 0
         jRet := BuildErro(400, "SEM_CAMPOS", "Nenhum campo para gravar.")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "04-regras"
      DbSelectArea("ZLE")
      ZLE->(DbSetOrder(1)) // ZLE_FILIAL+ZLE_PEDIDO+ZLE_NF+ZLE_SERIE
      cChave := FWxFilial("ZLE") + PadR(cPedido, TamSX3("ZLE_PEDIDO")[1]) + PadR(cNf, TamSX3("ZLE_NF")[1]) + PadR(cSerie, TamSX3("ZLE_SERIE")[1])
      lNovo := !ZLE->(DbSeek(cChave))
      dEnv := ValorDe(aVal, "ZLE_DTENV", IIf(lNovo, CToD(""), ZLE->ZLE_DTENV))
      dEnt := ValorDe(aVal, "ZLE_DTENTR", IIf(lNovo, CToD(""), ZLE->ZLE_DTENTR))
      If !Empty(dEnv) .and. dEnv < aNfInfo[1]
         jRet := BuildErro(400, "ENVIO_ANTES_NF", "Data de envio (" + DToC(dEnv) + ") anterior a emissao da NF (" + DToC(aNfInfo[1]) + ").")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dEnt) .and. Empty(dEnv)
         jRet := BuildErro(400, "ENTREGA_SEM_ENVIO", "Entrega so com a data de envio.")
         lRespondido := .T.
         Break
      EndIf
      If !Empty(dEnt) .and. dEnt < dEnv
         jRet := BuildErro(400, "ENTREGA_ANTES_ENVIO", "Data de entrega (" + DToC(dEnt) + ") anterior ao envio (" + DToC(dEnv) + ").")
         lRespondido := .T.
         Break
      EndIf

      cEtapa := "05-gravacao"
      If !RecLock("ZLE", lNovo)
         jRet := BuildErro(409, "ENVIO_EM_USO", "Envio em uso por outro usuario. Tente de novo.")
         lRespondido := .T.
         Break
      EndIf
      lTravou := .T.
      If lNovo
         ZLE->ZLE_FILIAL := FWxFilial("ZLE")
         ZLE->ZLE_PEDIDO := cPedido
         ZLE->ZLE_NF     := cNf
         ZLE->ZLE_SERIE  := cSerie
         // sem transportadora no corpo: a da NF
         If aScan(aVal, {|x| x[1] == "ZLE_TRANSP"}) == 0
            ZLE->ZLE_TRANSP := aNfInfo[2]
         EndIf
      EndIf
      For nI := 1 to Len(aVal)
         nPos := ZLE->(FieldPos(aVal[nI][1]))
         xAnt := ZLE->(FieldGet(nPos))
         cHA  := HistTxt(xAnt, aVal[nI][1])
         cHN  := HistTxt(aVal[nI][2], aVal[nI][1])
         If !(cHA == cHN)
            cTit := "NF " + AllTrim(cNf) + " - " + aVal[nI][3]
            aAdd(aHist, {"", IIf(lNovo .and. Empty(cHA), "I", "A"), aVal[nI][1], Left(cTit, 30), cHA, cHN})
         EndIf
         ZLE->(FieldPut(nPos, aVal[nI][2]))
      Next nI
      aU := UsrInfo()
      ZLE->ZLE_CODUSR := aU[1]
      ZLE->ZLE_USUARI := aU[2]
      ZLE->ZLE_DTALT  := Date()
      ZLE->ZLE_HRALT  := Time()
      ZLE->(MsUnlock())
      lTravou := .F.

      cEtapa := "05b-historico"
      If lHis .and. Len(aHist) > 0
         cAvisoH := GravaHists(cPedido, aHist, cOrigem)
      EndIf

      cEtapa := "06-resposta"
      aPed := ConsultaPedidos(CToD(""), CToD(""), {cPedido}, @aIgnora, @cEtapa, @cAlAberto)
      If Len(aPed) > 0
         If !Empty(cAvisoH)
            aPed[1]["avisoHistorico"] := TxtOut(cAvisoH)
         EndIf
         jRet := oRest:setStatusResponse(200, aPed[1]:ToJson())
      Else
         jRet := oRest:setStatusResponse(200, '{"recno":' + cValToChar(nRecno) + ',"aviso":"gravado"}')
      EndIf
      lRespondido := .T.

   Recover Using oErrCap
      If lTravou
         ZLE->(MsUnlock())
      EndIf
      If !Empty(cAlAberto) .and. Select(cAlAberto) > 0
         (cAlAberto)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

/*/{Protheus.doc} getVsLogHistorico
Historico da logistica de um pedido (ZLH), mais novo primeiro.
@type function
@author Romulo Garcia
@since 19/11/2026
@queryparam pedido, Character, numero do pedido (C5_NUM; zeros a esquerda completados)
/*/
@Get("/api/v1/vs-financial-data/logistica/historico")
User Function getVsLogHistorico() as Logical
Return LerHistorico()

Static Function LerHistorico()
   Local jQuery      := Nil
   Local jResp       := JsonObject():New()
   Local jRet        := Nil
   Local jH          := Nil
   Local aLin        := {}
   Local bErrOld     := ErrorBlock({|oE| Break(oE) })
   Local oErrCap     := Nil
   Local cEtapa      := "00-inicio"
   Local lRespondido := .F.
   Local cPedido     := ""
   Local cQuery      := ""
   Local cAl         := ""
   Local oStmt       := Nil
   Local nTam        := 0

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      cEtapa := "01-parametros"
      jQuery := oRest:getQueryRequest()
      If ValType(jQuery) != "J" .and. ValType(jQuery) != "O"
         jQuery := JsonObject():New()
      EndIf
      cPedido := Upper(AllTrim(SStr(jQuery["pedido"])))
      nTam := TamSX3("C5_NUM")[1]
      If !Empty(cPedido) .and. Len(cPedido) < nTam .and. SoDigitos(cPedido)
         cPedido := PadL(cPedido, nTam, "0")
      EndIf
      If Empty(cPedido) .or. Len(cPedido) > nTam
         jRet := BuildErro(400, "PEDIDO_INVALIDO", "Informe o pedido (pedido=NNNNNN).")
         lRespondido := .T.
         Break
      EndIf

      jResp["versao"] := LG_VERSAO
      jResp["pedido"] := cPedido
      jResp["temHistorico"] := TemTab("ZLH")
      If jResp["temHistorico"]
         cEtapa := "02-query"
         cQuery := "SELECT ZLH_DATA, ZLH_HORA, ZLH_ITEM, ZLH_ACAO, ZLH_ORIGEM, ZLH_CAMPO, ZLH_TITULO, "
         cQuery += "       ZLH_VALANT, ZLH_VALNOV, ZLH_CODUSR, ZLH_USUARI "
         cQuery += "FROM " + RetSqlName("ZLH") + " "
         cQuery += "WHERE ZLH_FILIAL = ? AND ZLH_PEDIDO = ? AND D_E_L_E_T_ = ' ' "
         cQuery += "ORDER BY ZLH_DATA DESC, ZLH_HORA DESC, R_E_C_N_O_ DESC "
         oStmt := FWExecStatement():New(cQuery)
         oStmt:SetString(1, FWxFilial("ZLH"))
         oStmt:SetString(2, PadR(cPedido, TamSX3("ZLH_PEDIDO")[1]))
         cAl := oStmt:OpenAlias(GetNextAlias())
         If !Empty(cAl) .and. Select(cAl) > 0
            Do While !(cAl)->(Eof())
               jH := JsonObject():New()
               jH["data"]    := IsoOut((cAl)->ZLH_DATA)
               jH["hora"]    := AllTrim(SStr((cAl)->ZLH_HORA))
               jH["item"]    := AllTrim(SStr((cAl)->ZLH_ITEM))
               jH["acao"]    := AllTrim(SStr((cAl)->ZLH_ACAO))
               jH["origem"]  := AllTrim(SStr((cAl)->ZLH_ORIGEM))
               jH["campo"]   := AllTrim(SStr((cAl)->ZLH_CAMPO))
               jH["titulo"]  := TxtOut((cAl)->ZLH_TITULO)
               jH["de"]      := TxtOut((cAl)->ZLH_VALANT)
               jH["para"]    := TxtOut((cAl)->ZLH_VALNOV)
               jH["codUsuario"] := AllTrim(SStr((cAl)->ZLH_CODUSR))
               jH["usuario"] := TxtOut((cAl)->ZLH_USUARI)
               aAdd(aLin, jH)
               (cAl)->(DbSkip())
            EndDo
            (cAl)->(DbCloseArea())
         EndIf
         oStmt:Destroy()
      EndIf
      jResp["historico"] := aLin
      jRet := oRest:setStatusResponse(200, jResp:ToJson())
      lRespondido := .T.

   Recover Using oErrCap
      If !Empty(cAl) .and. Select(cAl) > 0
         (cAl)->(DbCloseArea())
      EndIf
      oRest:setKeyHeaderResponse("X-Erro-Etapa", cEtapa)
      If !lRespondido
         jRet := BuildErro(500, "ERRO_INTERNO", "etapa=[" + cEtapa + "] " + TxtErro(oErrCap))
         lRespondido := .T.
      EndIf
   End Sequence

   ErrorBlock(bErrOld)
   If !lRespondido
      jRet := BuildErro(500, "ERRO_INTERNO", "Erro inesperado.")
   EndIf
Return jRet

// Tabela fisica com todas as colunas que a API usa, no schema da conexao
// (homologacao e producao no mesmo Oracle: sempre com LG_OWNER). Tabela ou
// coluna que nao existe derrubaria a thread do REST sem passar pelo Recover.
Static Function TemTab(cAlias)
   Local aCols  := {}
   Local cIn    := ""
   Local cAl    := ""
   Local oStmt  := Nil
   Local nCols  := 0
   Local nI     := 0
   Local cNome  := ""
   Local bErrAn := ErrorBlock({|oE| Break(oE) })

   If cAlias == "ZLE"
      aCols := {"ZLE_FILIAL", "ZLE_PEDIDO", "ZLE_NF", "ZLE_SERIE", "ZLE_DTENV", "ZLE_DTPREV", "ZLE_DTENTR", ;
         "ZLE_TPMAT", "ZLE_INDICA", "ZLE_TRANSP", "ZLE_CODUSR", "ZLE_USUARI", "ZLE_DTALT", "ZLE_HRALT", "D_E_L_E_T_"}
   ElseIf cAlias == "ZLC"
      aCols := {"ZLC_FILIAL", "ZLC_PEDIDO", "ZLC_ITEM", "ZLC_TIPO", "ZLC_CTE", "ZLC_DATA", "ZLC_TRANSP", ;
         "ZLC_VALOR", "ZLC_SITUA", "ZLC_VLRESP", "ZLC_OBS", "ZLC_CODUSR", "ZLC_USUARI", "ZLC_DTALT", "ZLC_HRALT", "D_E_L_E_T_"}
   Else
      aCols := {"ZLH_FILIAL", "ZLH_PEDIDO", "ZLH_ITEM", "ZLH_DATA", "ZLH_HORA", "ZLH_ACAO", "ZLH_ORIGEM", ;
         "ZLH_CAMPO", "ZLH_TITULO", "ZLH_VALANT", "ZLH_VALNOV", "ZLH_CODUSR", "ZLH_USUARI", "D_E_L_E_T_"}
   EndIf
   For nI := 1 to Len(aCols)
      cIn += IIf(nI > 1, ",", "") + "'" + aCols[nI] + "'"
   Next nI
   Begin Sequence
      // sem o SX2 do alias, o RetSqlName/FWxFilial nao servem
      DbSelectArea("SX2")
      SX2->(DbSetOrder(1))
      If !SX2->(DbSeek(cAlias))
         Break
      EndIf
      cNome := AllTrim(RetSqlName(cAlias))
      oStmt := FWExecStatement():New("SELECT COUNT(*) AS QTD FROM ALL_TAB_COLUMNS WHERE " + LG_OWNER + ;
         " AND TABLE_NAME = ? AND COLUMN_NAME IN (" + cIn + ")")
      oStmt:SetString(1, cNome)
      cAl := oStmt:OpenAlias(GetNextAlias())
      If !Empty(cAl) .and. Select(cAl) > 0
         nCols := NNum((cAl)->QTD)
         (cAl)->(DbCloseArea())
      EndIf
      oStmt:Destroy()
   End Sequence
   ErrorBlock(bErrAn)
Return nCols == Len(aCols)

// "custos" de cada pedido: lista da ZLC (lotes de 900 pedidos, limite do IN)
Static Function CustosPedidos(aPed)
   Local jCus   := JsonObject():New()
   Local aLote  := {}
   Local aVazio := {}
   Local nI     := 0
   Local lNf    := .F.

   If Len(aPed) == 0 .or. !TemTab("ZLC")
      Return Nil
   EndIf
   // NF do envio na cobranca (2026-11-25a): so se o campo ja existe
   lNf := "|ZLC_NF|" $ ColunasDe("ZLC")
   For nI := 1 to Len(aPed)
      aAdd(aLote, aPed[nI]["pedido"])
      If Len(aLote) == 900 .or. nI == Len(aPed)
         CustoLote(aLote, jCus, lNf)
         aLote := {}
      EndIf
   Next nI
   For nI := 1 to Len(aPed)
      If ValType(jCus[aPed[nI]["pedido"]]) == "A"
         aPed[nI]["custos"] := jCus[aPed[nI]["pedido"]]
      Else
         aVazio := {}
         aPed[nI]["custos"] := aVazio
      EndIf
   Next nI
Return Nil

Static Function CustoLote(aNums, jCus, lNf)
   Local cQuery := ""
   Local cAl    := ""
   Local oStmt  := Nil
   Local cIn    := ""
   Local cKey   := ""
   Local aLst   := {}
   Local jC     := Nil
   Local nI     := 0

   For nI := 1 to Len(aNums)
      cIn += IIf(nI > 1, ",", "") + "?"
   Next nI
   cQuery := "SELECT ZLC.ZLC_PEDIDO, ZLC.ZLC_ITEM, ZLC.ZLC_TIPO, ZLC.ZLC_CTE, ZLC.ZLC_DATA, ZLC.ZLC_TRANSP, "
   cQuery += "       ZLC.ZLC_VALOR, ZLC.ZLC_SITUA, ZLC.ZLC_VLRESP, ZLC.ZLC_OBS, ZLC.ZLC_USUARI, "
   cQuery += "       ZLC.ZLC_DTALT, ZLC.ZLC_HRALT, SA4.A4_NOME AS TRANSPNOME, "
   cQuery += "       " + IIf(lNf, "ZLC.ZLC_NF", "' '") + " AS ZLCNF "
   cQuery += "FROM " + RetSqlName("ZLC") + " ZLC "
   cQuery += "LEFT JOIN " + RetSqlName("SA4") + " SA4 ON (SA4.A4_FILIAL = '" + FWxFilial("SA4") + "' OR SA4.A4_FILIAL = ' ') "
   cQuery += "    AND SA4.A4_COD = ZLC.ZLC_TRANSP AND ZLC.ZLC_TRANSP <> ' ' AND SA4.D_E_L_E_T_ = ' ' "
   cQuery += "WHERE ZLC.ZLC_FILIAL = ? AND RTRIM(ZLC.ZLC_PEDIDO) IN (" + cIn + ") AND ZLC.D_E_L_E_T_ = ' ' "
   cQuery += "ORDER BY ZLC.ZLC_PEDIDO, ZLC.ZLC_ITEM "

   oStmt := FWExecStatement():New(cQuery)
   oStmt:SetString(1, FWxFilial("ZLC"))
   For nI := 1 to Len(aNums)
      oStmt:SetString(nI + 1, aNums[nI])
   Next nI
   cAl := oStmt:OpenAlias(GetNextAlias())
   If !Empty(cAl) .and. Select(cAl) > 0
      Do While !(cAl)->(Eof())
         cKey := AllTrim((cAl)->ZLC_PEDIDO)
         jC := JsonObject():New()
         jC["item"]           := AllTrim(SStr((cAl)->ZLC_ITEM))
         jC["tipo"]           := AllTrim(SStr((cAl)->ZLC_TIPO))
         jC["cte"]            := TxtOut((cAl)->ZLC_CTE)
         jC["data"]           := IsoOut((cAl)->ZLC_DATA)
         jC["transportadora"] := AllTrim(SStr((cAl)->ZLC_TRANSP))
         jC["transportadoraNome"] := TxtOut((cAl)->TRANSPNOME)
         jC["valor"]          := Round(NNum((cAl)->ZLC_VALOR), 2)
         jC["situacao"]       := AllTrim(SStr((cAl)->ZLC_SITUA))
         jC["valorEsperado"]  := Round(NNum((cAl)->ZLC_VLRESP), 2)
         jC["obs"]            := TxtOut((cAl)->ZLC_OBS)
         jC["usuario"]        := TxtOut((cAl)->ZLC_USUARI)
         jC["alteradoEm"]     := AllTrim(IsoOut((cAl)->ZLC_DTALT) + " " + AllTrim(SStr((cAl)->ZLC_HRALT)))
         jC["nf"]             := AllTrim(SStr((cAl)->ZLCNF))
         // o array do JsonObject pode vir copiado: monta e grava de volta
         aLst := IIf(ValType(jCus[cKey]) == "A", jCus[cKey], {})
         aAdd(aLst, jC)
         jCus[cKey] := aLst
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return Nil

// CTE/valor de envio (E) e reentrega (R) vindos pelo PUT (importacao): grava
// na 1a cobranca do tipo; sem cobranca do tipo, cria uma (se tiver CTE ou valor)
Static Function CustoDoPedido(cPedido, aCusto, dEnv, dNova, cTransp, aHist)
   Local aTipos := {{"E", "C5_ZCTE", "C5_ZVLRCTE"}, {"R", "C5_ZCTEREE", "C5_ZVCTERE"}}
   Local nT     := 0
   Local nC     := 0
   Local nV     := 0
   Local cItem  := ""
   Local cCte   := ""
   Local nVal   := 0
   Local cHA    := ""
   Local cHN    := ""

   DbSelectArea("ZLC")
   For nT := 1 to Len(aTipos)
      nC := aScan(aCusto, {|x| x[1] == aTipos[nT][2]})
      nV := aScan(aCusto, {|x| x[1] == aTipos[nT][3]})
      If nC == 0 .and. nV == 0
         Loop
      EndIf
      cCte := IIf(nC > 0, AllTrim(SStr(aCusto[nC][2])), "")
      nVal := IIf(nV > 0, Round(NNum(aCusto[nV][2]), 2), 0)
      If !PosicionaTipo(cPedido, aTipos[nT][1])
         If Empty(cCte) .and. nVal == 0
            Loop
         EndIf
         cItem := ProxItem(cPedido)
         RecLock("ZLC", .T.)
         ZLC->ZLC_FILIAL := FWxFilial("ZLC")
         ZLC->ZLC_PEDIDO := cPedido
         ZLC->ZLC_ITEM   := cItem
         ZLC->ZLC_TIPO   := aTipos[nT][1]
         ZLC->ZLC_CTE    := cCte
         ZLC->ZLC_VALOR  := nVal
         ZLC->ZLC_DATA   := IIf(aTipos[nT][1] == "E", dEnv, dNova)
         ZLC->ZLC_TRANSP := cTransp
         Carimbo()
         aAdd(aHist, {cItem, "I", "ZLC", "Cobranca incluida", "", ResumoCusto()})
         ZLC->(MsUnlock())
      Else
         cItem := ZLC->ZLC_ITEM
         RecLock("ZLC", .F.)
         If nC > 0
            cHA := HistTxt(ZLC->ZLC_CTE, "ZLC_CTE")
            cHN := HistTxt(cCte, "ZLC_CTE")
            If !(cHA == cHN)
               aAdd(aHist, {cItem, "A", "ZLC_CTE", TituloCampo("ZLC_CTE"), cHA, cHN})
               ZLC->ZLC_CTE := cCte
            EndIf
         EndIf
         If nV > 0
            cHA := HistTxt(ZLC->ZLC_VALOR, "ZLC_VALOR")
            cHN := HistTxt(nVal, "ZLC_VALOR")
            If !(cHA == cHN)
               aAdd(aHist, {cItem, "A", "ZLC_VALOR", TituloCampo("ZLC_VALOR"), cHA, cHN})
               ZLC->ZLC_VALOR := nVal
            EndIf
         EndIf
         Carimbo()
         ZLC->(MsUnlock())
      EndIf
   Next nT
Return Nil

// Posiciona a ZLC na 1a cobranca (nao excluida) do tipo no pedido
Static Function PosicionaTipo(cPedido, cTipo)
   Local cChave := FWxFilial("ZLC") + PadR(cPedido, TamSX3("ZLC_PEDIDO")[1])
   ZLC->(DbSetOrder(1))
   ZLC->(DbSeek(cChave))
   Do While !ZLC->(Eof()) .and. ZLC->(ZLC_FILIAL + ZLC_PEDIDO) == cChave
      If ZLC->ZLC_TIPO == cTipo
         Return .T.
      EndIf
      ZLC->(DbSkip())
   EndDo
Return .F.

// Proximo ZLC_ITEM do pedido, contando os excluidos (o numero nunca se repete)
Static Function ProxItem(cPedido)
   Local cAl   := ""
   Local oStmt := Nil
   Local cUlt  := ""
   oStmt := FWExecStatement():New("SELECT MAX(ZLC_ITEM) AS ULT FROM " + RetSqlName("ZLC") + " WHERE ZLC_FILIAL = ? AND ZLC_PEDIDO = ?")
   oStmt:SetString(1, FWxFilial("ZLC"))
   oStmt:SetString(2, PadR(cPedido, TamSX3("ZLC_PEDIDO")[1]))
   cAl := oStmt:OpenAlias(GetNextAlias())
   If !Empty(cAl) .and. Select(cAl) > 0
      cUlt := AllTrim(SStr((cAl)->ULT))
      (cAl)->(DbCloseArea())
   EndIf
   oStmt:Destroy()
Return IIf(Empty(cUlt), StrZero(1, TamSX3("ZLC_ITEM")[1]), Soma1(cUlt))

// Quem e quando alterou a cobranca (ZLC posicionada e travada)
Static Function Carimbo()
   Local aU := UsrInfo()
   ZLC->ZLC_CODUSR := aU[1]
   ZLC->ZLC_USUARI := aU[2]
   ZLC->ZLC_DTALT  := Date()
   ZLC->ZLC_HRALT  := Time()
Return Nil

// "Envio - CTE 123 - R$ 850,00 - Divergente" da ZLC posicionada
Static Function ResumoCusto()
   Local cR := HistTxt(ZLC->ZLC_TIPO, "ZLC_TIPO")
   If !Empty(ZLC->ZLC_CTE)
      cR += " - CTE " + AllTrim(ZLC->ZLC_CTE)
   EndIf
   cR += " - R$ " + AllTrim(Transform(ZLC->ZLC_VALOR, "@E 999,999,999.99"))
   If !Empty(ZLC->ZLC_SITUA)
      cR += " - " + HistTxt(ZLC->ZLC_SITUA, "ZLC_SITUA")
   EndIf
   If ZLC->(FieldPos("ZLC_NF")) > 0 .and. !Empty(ZLC->ZLC_NF)
      cR += " - NF " + AllTrim(ZLC->ZLC_NF)
   EndIf
Return cR

// Valor em texto para o historico (CP1252, como no banco)
Static Function HistTxt(xV, cCampo)
   Local cRet := ""
   Local cDes := ""
   Do Case
   Case ValType(xV) == "D"
      If !Empty(xV)
         cRet := StrZero(Day(xV), 2) + "/" + StrZero(Month(xV), 2) + "/" + StrZero(Year(xV), 4)
      EndIf
   Case ValType(xV) == "N"
      If xV != 0
         If ("|" + AllTrim(cCampo) + "|") $ "|C5_ZVLRCTE|C5_ZVCTERE|ZLC_VALOR|ZLC_VLRESP|C5_FRETE|"
            cRet := AllTrim(Transform(xV, "@E 999,999,999.99"))
         Else
            cRet := StrTran(cValToChar(xV), ".", ",")
         EndIf
      EndIf
   Case ValType(xV) $ "CM"
      cRet := AllTrim(StrTran(StrTran(xV, Chr(13), " "), Chr(10), " "))
      If !Empty(cRet)
         cDes := ComboDesc(cCampo, cRet)
         If !Empty(cDes)
            cRet := cRet + " - " + cDes
         EndIf
      EndIf
   EndCase
Return Left(cRet, 250)

// Descricao do codigo no X3_CBOX, sem converter (vazio se o campo nao tem combo)
Static Function ComboDesc(cCampo, cCod)
   Local cBox := ""
   Local aOpc := {}
   Local nI   := 0
   Local nPos := 0
   cBox := AllTrim(SStr(GetSX3Cache(AllTrim(cCampo), "X3_CBOX")))
   If Empty(cBox)
      Return ""
   EndIf
   aOpc := StrTokArr(cBox, ";")
   For nI := 1 to Len(aOpc)
      nPos := At("=", aOpc[nI])
      If nPos > 0 .and. AllTrim(SubStr(aOpc[nI], 1, nPos - 1)) == cCod
         Return AllTrim(SubStr(aOpc[nI], nPos + 1))
      EndIf
   Next nI
Return ""

// Grava as linhas do historico. Erro aqui nao desfaz a gravacao principal (ja
// feita): volta o texto do erro para a resposta avisar a tela.
// aHist: {item, acao, campo, titulo, antes, depois}
Static Function GravaHists(cPedido, aHist, cOrigem)
   Local cErro  := ""
   Local oErr   := Nil
   Local aU     := UsrInfo()
   Local nI     := 0
   Local bErrAn := ErrorBlock({|oE| Break(oE) })
   Begin Sequence
      DbSelectArea("ZLH")
      For nI := 1 to Len(aHist)
         RecLock("ZLH", .T.)
         ZLH->ZLH_FILIAL := FWxFilial("ZLH")
         ZLH->ZLH_PEDIDO := cPedido
         ZLH->ZLH_ITEM   := aHist[nI][1]
         ZLH->ZLH_DATA   := Date()
         ZLH->ZLH_HORA   := Time()
         ZLH->ZLH_ACAO   := aHist[nI][2]
         ZLH->ZLH_ORIGEM := cOrigem
         ZLH->ZLH_CAMPO  := aHist[nI][3]
         ZLH->ZLH_TITULO := Left(aHist[nI][4], TamSX3("ZLH_TITULO")[1])
         ZLH->ZLH_VALANT := Left(aHist[nI][5], TamSX3("ZLH_VALANT")[1])
         ZLH->ZLH_VALNOV := Left(aHist[nI][6], TamSX3("ZLH_VALNOV")[1])
         ZLH->ZLH_CODUSR := aU[1]
         ZLH->ZLH_USUARI := aU[2]
         ZLH->(MsUnlock())
      Next nI
   Recover Using oErr
      cErro := "Gravado, mas o historico falhou: " + TxtErro(oErr)
   End Sequence
   ErrorBlock(bErrAn)
Return cErro

// {codigo, nome} do usuario da sessao (token da tela)
Static Function UsrInfo()
   Local aU     := {"", "?"}
   Local bErrAn := ErrorBlock({|oE| Break(oE) })
   Begin Sequence
      aU[1] := AllTrim(RetCodUsr())
      aU[2] := Left(AllTrim(UsrRetName(aU[1])), 25)
   End Sequence
   ErrorBlock(bErrAn)
Return aU

// Valor de um campo em aVal ({campo, valor}) ou o padrao
Static Function ValorDe(aVal, cCampo, xPadrao)
   Local nP := aScan(aVal, {|x| x[1] == cCampo})
Return IIf(nP > 0, aVal[nP][2], xPadrao)


// ----------------------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------------------

// Texto de valor -> numero: "1.234,56", "1234.56", "R$ 150,00", "150" (vazio = 0)
Static Function ValTxt(cTxt)
   Local cV := Upper(AllTrim(SStr(cTxt)))
   cV := StrTran(cV, "R$", "")
   cV := StrTran(cV, " ", "")
   If Empty(cV)
      Return 0
   EndIf
   If "," $ cV
      cV := StrTran(cV, ".", "")
      cV := StrTran(cV, ",", ".")
   EndIf
Return Val(cV)

// Numero vindo da tela (numero ou texto)
Static Function NumIn(xV)
   If ValType(xV) == "N"
      Return xV
   ElseIf ValType(xV) == "C"
      Return ValTxt(xV)
   EndIf
Return 0

Static Function ArrToTxt(aArr)
   Local cRet := ""
   Local nI   := 0
   For nI := 1 to Len(aArr)
      cRet += IIf(nI > 1, ", ", "") + aArr[nI]
   Next nI
Return cRet

Static Function SimNao(xValor)
   Local cVal := Upper(AllTrim(cValToChar(xValor)))
   If Empty(cVal)
      Return ""
   EndIf
Return IIf(cVal $ "S|1|SIM", "SIM", "NAO")

// "AAAA-MM-DD" (ou AAAAMMDD) da tela -> data; invalida/ausente = data vazia
Static Function IsoIn(xV)
   Local cV := StrTran(AllTrim(SStr(xV)), "-", "")
   Local dV := CToD("")
   If Len(cV) == 8
      dV := SToD(cV)
   EndIf
Return dV

// Texto vindo da tela (UTF-8) para gravar no banco (CP1252)
Static Function TxtIn(xV)
   Local cV := ""
   Local cD := Nil
   If ValType(xV) == "N"
      Return cValToChar(xV)
   ElseIf ValType(xV) != "C"
      Return ""
   EndIf
   cV := xV
   cD := DecodeUTF8(cV)
Return IIf(ValType(cD) == "C", cD, cV)

// ============================================================================
// LOGISTICA REVERSA - DIAGNOSTICO (SO LEITURA, 2026-11-24a)
// GET /api/v1/vs-financial-data/logistica/reversa/diagnostico[?meses=24]
// Levantamento antes de desenhar a aba Reversa (pedido do usuario, 24/11/2026;
// ver IDEIAS-REVERSA-E-CTE.md). Nada e gravado. Escopo: locacao e comodato.
//   - tes: TES 607/906/456/610 e as de CFOP x908/x909 (estoque, poder de terceiros)
//   - retornosPorMes: entradas de retorno (CFOP x909 ou TES 456) por mes de
//     digitacao x formulario proprio x origem do lancamento x TES x armazem x
//     NF de origem preenchida x movimento de estoque (D1_NUMSEQ)
//   - retornoXRemessa: se a entrada aponta a remessa (D1_NFORI) e como a
//     remessa foi feita (com pedido = Protheus; sem pedido = MATA920), dias
//   - retornosRecentes: as 40 ultimas entradas de retorno, linha a linha
//   - remessasPorMes: saidas x908 ou TES 607/906 (sem filtro de data: as do ERP
//     antigo entram com a data da NF antiga)
//   - equipamentosNoCliente / clientesComEquipamento: remessa x908 menos o que
//     voltou pelo D1_NFORI (saldo no cliente)
//   - freteLocCom: pedidos LOC/COM (C5_ZTPPEDI) com frete
//   - ctesPorMes / ctesPorTransportadora / ctesTesCfop / ctesRecentes: CTEs de
//     entrada (F1_ESPECIE CT*) e ctesXZlc: CTEs da ZLC achados no fiscal
//   - tabelasXml: tabelas de XML/importador (CKO, SDS, SDT, C00) e linhas
//   - armazens (NNR) dos retornos; tabelasZ (nomes Z em uso)
// Cada secao roda separada (erro vai para "erros"). Colunas opcionais so entram
// depois de achadas no ALL_TAB_COLUMNS: coluna inexistente derruba a thread.
// ============================================================================
@Get("/api/v1/vs-financial-data/logistica/reversa/diagnostico")
User Function getVsLogRevDiag() as Logical
Return DiagReversa()

Static Function DiagReversa()
   Local jQuery  := oRest:getQueryRequest()
   Local jResp   := JsonObject():New()
   Local jRet    := Nil
   Local bErrOld := ErrorBlock({|oE| Break(oE) })
   Local oErr    := Nil
   Local aErros  := {}
   Local nMeses  := 24
   Local cDesde  := ""
   Local cSuf    := ""
   Local cSD1    := RetSqlName("SD1")
   Local cSF1    := RetSqlName("SF1")
   Local cSD2    := RetSqlName("SD2")
   Local cSF4    := RetSqlName("SF4")
   Local cSA1    := RetSqlName("SA1")
   Local cSA2    := RetSqlName("SA2")
   Local cSC5    := RetSqlName("SC5")
   Local cFD1    := FWxFilial("SD1")
   Local cFF1    := FWxFilial("SF1")
   Local cFD2    := FWxFilial("SD2")
   Local cFF4    := FWxFilial("SF4")
   Local cFA1    := FWxFilial("SA1")
   Local cFA2    := FWxFilial("SA2")
   Local cFC5    := FWxFilial("SC5")
   Local cExD1   := ""
   Local cExD2   := ""
   Local cExF1   := ""
   Local cExF4   := ""
   Local cExC5   := ""
   Local cFalta  := ""
   Local cOriD1  := ""
   Local cOriD2  := ""
   Local cItOri  := ""
   Local cItOriR := ""
   Local cNumSeq := ""
   Local cChave  := ""
   Local cPod3   := ""
   Local cTpPed  := ""
   Local cRetF   := ""
   Local cRetJ   := ""
   Local cRemF   := ""
   Local cRemJ   := ""
   Local cVolta  := ""
   Local cSaldo  := ""
   Local cDias   := ""
   Local cCteF   := ""
   Local cTabs   := ""
   Local aXml    := {}
   Local aAchou  := {}
   Local jXml    := Nil
   Local nI      := 0

   oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=UTF-8")
   oRest:setKeyHeaderResponse("Access-Control-Allow-Origin", "*")

   Begin Sequence
      If ValType(jQuery) == "J" .or. ValType(jQuery) == "O"
         nMeses := NNum(jQuery["meses"])
      EndIf
      If nMeses <= 0
         nMeses := 24
      EndIf
      nMeses := Min(nMeses, 60)
      cDesde := Left(DToS(Date() - (nMeses * 30)), 6) + "01"
      cSuf   := SubStr(AllTrim(cSD1), 4)

      jResp["versao"]   := LG_VERSAO
      jResp["empresa"]  := TxtOut(cEmpAnt)
      jResp["filial"]   := TxtOut(cFilAnt)
      jResp["desde"]    := cDesde
      jResp["geradoEm"] := DToS(Date()) + " " + Time()

      // colunas: as obrigatorias sao padrao; as opcionais viram ' '
      cExD1 := ColunasDe("SD1")
      cExD2 := ColunasDe("SD2")
      cExF1 := ColunasDe("SF1")
      cExF4 := ColunasDe("SF4")
      cExC5 := ColunasDe("SC5")
      cFalta := Faltam(cExD1, {"D1_FILIAL", "D1_DOC", "D1_SERIE", "D1_FORNECE", "D1_LOJA", "D1_ITEM", "D1_COD", ;
         "D1_QUANT", "D1_TOTAL", "D1_TES", "D1_CF", "D1_LOCAL", "D1_NFORI", "D1_SERIORI", "D1_DTDIGIT"}) + ;
         Faltam(cExD2, {"D2_FILIAL", "D2_DOC", "D2_SERIE", "D2_CLIENTE", "D2_LOJA", "D2_ITEM", "D2_COD", ;
         "D2_QUANT", "D2_TES", "D2_CF", "D2_EMISSAO", "D2_PEDIDO"}) + ;
         Faltam(cExF1, {"F1_FILIAL", "F1_DOC", "F1_SERIE", "F1_FORNECE", "F1_LOJA", "F1_FORMUL", "F1_TIPO", ;
         "F1_ESPECIE", "F1_EMISSAO", "F1_DTDIGIT", "F1_VALBRUT"}) + ;
         Faltam(cExF4, {"F4_FILIAL", "F4_CODIGO", "F4_TIPO", "F4_CF", "F4_ESTOQUE", "F4_DUPLIC", "F4_TEXTO"})
      If !Empty(cFalta)
         aAdd(aErros, "colunas padrao que faltam (secoes puladas): " + cFalta)
         jResp["erros"] := aErros
         jRet := oRest:setStatusResponse(200, jResp:ToJson())
         Break
      EndIf
      cOriD1  := IIf("|D1_ORIGLAN|" $ cExD1, "SD1.D1_ORIGLAN", "' '")
      cOriD2  := IIf("|D2_ORIGLAN|" $ cExD2, "SD2.D2_ORIGLAN", "' '")
      cNumSeq := IIf("|D1_NUMSEQ|" $ cExD1, "CASE WHEN SD1.D1_NUMSEQ <> ' ' THEN 'S' ELSE 'N' END", "'?'")
      cChave  := IIf("|F1_CHVNFE|" $ cExF1, "CASE WHEN SF1.F1_CHVNFE <> ' ' THEN 'S' ELSE 'N' END", "'?'")
      cPod3   := IIf("|F4_PODER3|" $ cExF4, "SF4.F4_PODER3", "' '")
      cTpPed  := IIf("|C5_ZTPPEDI|" $ cExC5, "SC5.C5_ZTPPEDI", "' '")
      If "|D1_ITEMORI|" $ cExD1
         cItOri  := " AND (SD1.D1_ITEMORI = ' ' OR SD1.D1_ITEMORI = SD2.D2_ITEM)"
         cItOriR := " AND (R.D1_ITEMORI = ' ' OR R.D1_ITEMORI = SD2.D2_ITEM)"
      EndIf
      jResp["colunasOpcionais"] := { ;
         "D1_ORIGLAN=" + IIf("|D1_ORIGLAN|" $ cExD1, "S", "N"), "D2_ORIGLAN=" + IIf("|D2_ORIGLAN|" $ cExD2, "S", "N"), ;
         "D1_NUMSEQ=" + IIf("|D1_NUMSEQ|" $ cExD1, "S", "N"), "D1_ITEMORI=" + IIf("|D1_ITEMORI|" $ cExD1, "S", "N"), ;
         "F1_CHVNFE=" + IIf("|F1_CHVNFE|" $ cExF1, "S", "N"), "F4_PODER3=" + IIf("|F4_PODER3|" $ cExF4, "S", "N"), ;
         "C5_ZTPPEDI=" + IIf("|C5_ZTPPEDI|" $ cExC5, "S", "N")}

      // ---------- TES ----------
      jResp["tes"] := DiagLinhas("tes", ;
         "SELECT SF4.F4_CODIGO AS TES, SF4.F4_TIPO AS TIPO, SF4.F4_CF AS CFOP, SF4.F4_ESTOQUE AS ESTOQUE, " + ;
         "SF4.F4_DUPLIC AS DUPLIC, " + cPod3 + " AS PODER3, SF4.F4_TEXTO AS TEXTO FROM " + cSF4 + " SF4 " + ;
         "WHERE SF4.F4_FILIAL = '" + cFF4 + "' AND SF4.D_E_L_E_T_ = ' ' AND (SF4.F4_CODIGO IN ('607','906','456','610') " + ;
         "OR SUBSTR(SF4.F4_CF, 2, 3) IN ('908','909')) ORDER BY 1", aErros)

      // ---------- entradas de retorno (x909 ou TES 456) ----------
      cRetJ := " FROM " + cSD1 + " SD1 INNER JOIN " + cSF1 + " SF1 ON SF1.F1_FILIAL = SD1.D1_FILIAL AND SF1.F1_DOC = SD1.D1_DOC " + ;
         "AND SF1.F1_SERIE = SD1.D1_SERIE AND SF1.F1_FORNECE = SD1.D1_FORNECE AND SF1.F1_LOJA = SD1.D1_LOJA AND SF1.D_E_L_E_T_ = ' ' " + ;
         "LEFT JOIN " + cSF4 + " SF4 ON SF4.F4_FILIAL = '" + cFF4 + "' AND SF4.F4_CODIGO = SD1.D1_TES AND SF4.D_E_L_E_T_ = ' ' "
      cRetF := " WHERE SD1.D1_FILIAL = '" + cFD1 + "' AND SD1.D_E_L_E_T_ = ' ' AND SD1.D1_DTDIGIT >= '" + cDesde + "' " + ;
         "AND (SUBSTR(SD1.D1_CF, 2, 3) = '909' OR SD1.D1_TES = '456') "
      jResp["retornosPorMes"] := DiagLinhas("retornosPorMes", ;
         "SELECT SUBSTR(SD1.D1_DTDIGIT, 1, 6) AS MES, SF1.F1_FORMUL AS FORMUL, SF1.F1_TIPO AS TIPO, SF1.F1_ESPECIE AS ESPECIE, " + ;
         cOriD1 + " AS ORIGLAN, SD1.D1_TES AS TES, SD1.D1_CF AS CFOP, SF4.F4_ESTOQUE AS TES_ESTOQUE, " + ;
         cNumSeq + " AS MOVIMENTO, SD1.D1_LOCAL AS ARMAZEM, " + ;
         "CASE WHEN SD1.D1_NFORI <> ' ' THEN 'S' ELSE 'N' END AS TEM_NFORI, " + ;
         "COUNT(DISTINCT SD1.D1_DOC || SD1.D1_SERIE || SD1.D1_FORNECE) AS NFS, COUNT(*) AS ITENS, SUM(SD1.D1_QUANT) AS QUANT" + ;
         cRetJ + cRetF + ;
         "GROUP BY SUBSTR(SD1.D1_DTDIGIT, 1, 6), SF1.F1_FORMUL, SF1.F1_TIPO, SF1.F1_ESPECIE, " + cOriD1 + ", SD1.D1_TES, " + ;
         "SD1.D1_CF, SF4.F4_ESTOQUE, " + cNumSeq + ", SD1.D1_LOCAL, CASE WHEN SD1.D1_NFORI <> ' ' THEN 'S' ELSE 'N' END " + ;
         "ORDER BY 1, 2", aErros)

      // remessa apontada pela entrada (D1_NFORI), com o pedido de origem
      cRemJ := "LEFT JOIN " + cSD2 + " SD2 ON SD2.D2_FILIAL = '" + cFD2 + "' AND SD1.D1_NFORI <> ' ' " + ;
         "AND SD2.D2_DOC = SD1.D1_NFORI AND SD2.D2_SERIE = SD1.D1_SERIORI AND SD2.D2_CLIENTE = SD1.D1_FORNECE " + ;
         "AND SD2.D2_LOJA = SD1.D1_LOJA AND SD2.D2_COD = SD1.D1_COD AND SD2.D_E_L_E_T_ = ' '" + cItOri + " " + ;
         "LEFT JOIN " + cSC5 + " SC5 ON SC5.C5_FILIAL = '" + cFC5 + "' AND SD2.D2_PEDIDO <> ' ' " + ;
         "AND SC5.C5_NUM = SD2.D2_PEDIDO AND SC5.D_E_L_E_T_ = ' ' "
      cDias := "CASE WHEN SD2.D2_EMISSAO <> ' ' AND SD1.D1_DTDIGIT <> ' ' THEN " + ;
         "TO_DATE(SD1.D1_DTDIGIT, 'YYYYMMDD') - TO_DATE(SD2.D2_EMISSAO, 'YYYYMMDD') END"
      cVolta := "CASE WHEN SD1.D1_NFORI = ' ' THEN '1-SEM NF ORIGEM' WHEN SD2.D2_DOC IS NULL THEN '2-REMESSA NAO ACHADA' " + ;
         "WHEN SD2.D2_PEDIDO = ' ' THEN '3-REMESSA SEM PEDIDO' ELSE '4-REMESSA COM PEDIDO' END"
      jResp["retornoXRemessa"] := DiagLinhas("retornoXRemessa", ;
         "SELECT " + cVolta + " AS VINCULO, SF1.F1_FORMUL AS FORMUL, SD2.D2_TES AS TES_REM, SD2.D2_CF AS CFOP_REM, " + ;
         cOriD2 + " AS ORIGLAN_REM, " + cTpPed + " AS TIPOPED, COUNT(*) AS ITENS, " + ;
         "ROUND(AVG(" + cDias + "), 0) AS DIAS_MEDIO, MIN(" + cDias + ") AS DIAS_MIN, MAX(" + cDias + ") AS DIAS_MAX" + ;
         cRetJ + cRemJ + cRetF + ;
         "GROUP BY " + cVolta + ", SF1.F1_FORMUL, SD2.D2_TES, SD2.D2_CF, " + cOriD2 + ", " + cTpPed + " ORDER BY 1, 2", aErros)
      jResp["retornosRecentes"] := DiagLinhas("retornosRecentes", ;
         "SELECT * FROM (SELECT SD1.D1_DOC AS DOC, SD1.D1_SERIE AS SERIE, SD1.D1_FORNECE AS CLIENTE, SD1.D1_LOJA AS LOJA, " + ;
         "SA1.A1_NOME AS NOME, SF1.F1_EMISSAO AS EMISSAO, SD1.D1_DTDIGIT AS DIGITACAO, SF1.F1_FORMUL AS FORMUL, " + ;
         "SF1.F1_TIPO AS TIPO, SF1.F1_ESPECIE AS ESPECIE, " + cChave + " AS TEM_CHAVE, " + cOriD1 + " AS ORIGLAN, " + ;
         cNumSeq + " AS MOVIMENTO, SD1.D1_ITEM AS ITEM, SD1.D1_COD AS PRODUTO, SD1.D1_QUANT AS QUANT, SD1.D1_TES AS TES, " + ;
         "SD1.D1_CF AS CFOP, SD1.D1_LOCAL AS ARMAZEM, SD1.D1_NFORI AS NFORI, SD1.D1_SERIORI AS SERIORI, " + ;
         "SD2.D2_EMISSAO AS EMISSAO_REM, SD2.D2_PEDIDO AS PEDIDO_REM, SD2.D2_TES AS TES_REM, SD2.D2_CF AS CFOP_REM, " + ;
         cTpPed + " AS TIPOPED, " + cDias + " AS DIAS" + ;
         cRetJ + cRemJ + ;
         "LEFT JOIN " + cSA1 + " SA1 ON SA1.A1_FILIAL = '" + cFA1 + "' AND SA1.A1_COD = SD1.D1_FORNECE " + ;
         "AND SA1.A1_LOJA = SD1.D1_LOJA AND SA1.D_E_L_E_T_ = ' ' " + ;
         cRetF + "ORDER BY SD1.D1_DTDIGIT DESC, SD1.D1_DOC DESC, SD1.D1_ITEM) WHERE ROWNUM <= 40", aErros)

      // ---------- remessas (x908 ou TES 607/906), sem filtro de data ----------
      cRemF := " WHERE SD2.D2_FILIAL = '" + cFD2 + "' AND SD2.D_E_L_E_T_ = ' ' " + ;
         "AND (SUBSTR(SD2.D2_CF, 2, 3) = '908' OR SD2.D2_TES IN ('607','906')) "
      jResp["remessasPorMes"] := DiagLinhas("remessasPorMes", ;
         "SELECT SUBSTR(SD2.D2_EMISSAO, 1, 6) AS MES, SD2.D2_TES AS TES, SD2.D2_CF AS CFOP, " + cOriD2 + " AS ORIGLAN, " + ;
         "CASE WHEN SD2.D2_PEDIDO <> ' ' THEN 'S' ELSE 'N' END AS COM_PEDIDO, " + cTpPed + " AS TIPOPED, " + ;
         "COUNT(DISTINCT SD2.D2_DOC || SD2.D2_SERIE) AS NFS, COUNT(*) AS ITENS, SUM(SD2.D2_QUANT) AS QUANT " + ;
         "FROM " + cSD2 + " SD2 LEFT JOIN " + cSC5 + " SC5 ON SC5.C5_FILIAL = '" + cFC5 + "' AND SD2.D2_PEDIDO <> ' ' " + ;
         "AND SC5.C5_NUM = SD2.D2_PEDIDO AND SC5.D_E_L_E_T_ = ' '" + cRemF + ;
         "GROUP BY SUBSTR(SD2.D2_EMISSAO, 1, 6), SD2.D2_TES, SD2.D2_CF, " + cOriD2 + ", " + ;
         "CASE WHEN SD2.D2_PEDIDO <> ' ' THEN 'S' ELSE 'N' END, " + cTpPed + " ORDER BY 1, 2", aErros)

      // saldo no cliente = remessa x908 menos o que voltou apontando para ela
      cSaldo := "SELECT SD2.D2_CLIENTE AS CLIENTE, SD2.D2_LOJA AS LOJA, SUBSTR(SD2.D2_EMISSAO, 1, 4) AS ANO, " + ;
         "SD2.D2_TES AS TES, CASE WHEN SD2.D2_PEDIDO <> ' ' THEN 'S' ELSE 'N' END AS COM_PEDIDO, " + cTpPed + " AS TIPOPED, " + ;
         "SD2.D2_EMISSAO AS EMISSAO, SD2.D2_QUANT AS QREM, " + ;
         "NVL((SELECT SUM(R.D1_QUANT) FROM " + cSD1 + " R WHERE R.D1_FILIAL = '" + cFD1 + "' AND R.D_E_L_E_T_ = ' ' " + ;
         "AND R.D1_NFORI = SD2.D2_DOC AND R.D1_SERIORI = SD2.D2_SERIE AND R.D1_FORNECE = SD2.D2_CLIENTE " + ;
         "AND R.D1_LOJA = SD2.D2_LOJA AND R.D1_COD = SD2.D2_COD" + cItOriR + "), 0) AS QRET " + ;
         "FROM " + cSD2 + " SD2 LEFT JOIN " + cSC5 + " SC5 ON SC5.C5_FILIAL = '" + cFC5 + "' AND SD2.D2_PEDIDO <> ' ' " + ;
         "AND SC5.C5_NUM = SD2.D2_PEDIDO AND SC5.D_E_L_E_T_ = ' '" + cRemF
      jResp["equipamentosNoCliente"] := DiagLinhas("equipamentosNoCliente", ;
         "SELECT X.ANO, X.TES, X.COM_PEDIDO, X.TIPOPED, COUNT(*) AS ITENS, SUM(X.QREM) AS QTD_REMESSA, " + ;
         "SUM(X.QRET) AS QTD_VOLTOU, SUM(CASE WHEN X.QRET >= X.QREM THEN 1 ELSE 0 END) AS ITENS_TOTAL, " + ;
         "SUM(CASE WHEN X.QRET > 0 AND X.QRET < X.QREM THEN 1 ELSE 0 END) AS ITENS_PARCIAL, " + ;
         "SUM(CASE WHEN X.QRET < X.QREM THEN X.QREM - X.QRET ELSE 0 END) AS SALDO_NO_CLIENTE " + ;
         "FROM (" + cSaldo + ") X GROUP BY X.ANO, X.TES, X.COM_PEDIDO, X.TIPOPED ORDER BY 1, 2", aErros)
      jResp["clientesComEquipamento"] := DiagLinhas("clientesComEquipamento", ;
         "SELECT * FROM (SELECT X.CLIENTE, X.LOJA, MAX(SA1.A1_NOME) AS NOME, COUNT(*) AS ITENS, " + ;
         "SUM(X.QREM - X.QRET) AS SALDO, MIN(X.EMISSAO) AS PRIMEIRA, MAX(X.EMISSAO) AS ULTIMA " + ;
         "FROM (" + cSaldo + ") X LEFT JOIN " + cSA1 + " SA1 ON SA1.A1_FILIAL = '" + cFA1 + "' AND SA1.A1_COD = X.CLIENTE " + ;
         "AND SA1.A1_LOJA = X.LOJA AND SA1.D_E_L_E_T_ = ' ' WHERE X.QRET < X.QREM " + ;
         "GROUP BY X.CLIENTE, X.LOJA ORDER BY 5 DESC) WHERE ROWNUM <= 30", aErros)

      // ---------- frete dos pedidos de locacao/comodato ----------
      If "|C5_ZTPPEDI|" $ cExC5
         jResp["freteLocCom"] := DiagLinhas("freteLocCom", ;
            "SELECT SC5.C5_ZTPPEDI AS TIPOPED, SUBSTR(SC5.C5_EMISSAO, 1, 4) AS ANO, COUNT(*) AS PEDIDOS, " + ;
            "SUM(CASE WHEN SC5.C5_FRETE > 0 THEN 1 ELSE 0 END) AS COM_FRETE, SUM(SC5.C5_FRETE) AS FRETE" + ;
            IIf("|C5_ZFRETE|" $ cExC5, ", SUM(CASE WHEN SC5.C5_ZFRETE <> ' ' THEN 1 ELSE 0 END) AS COM_ZFRETE", "") + ;
            " FROM " + cSC5 + " SC5 WHERE SC5.C5_FILIAL = '" + cFC5 + "' AND SC5.D_E_L_E_T_ = ' ' " + ;
            "AND SC5.C5_ZTPPEDI IN ('LOC','COM') GROUP BY SC5.C5_ZTPPEDI, SUBSTR(SC5.C5_EMISSAO, 1, 4) ORDER BY 1, 2", aErros)
      EndIf

      // ---------- CTEs de entrada ----------
      cCteF := " WHERE SF1.F1_FILIAL = '" + cFF1 + "' AND SF1.D_E_L_E_T_ = ' ' AND SF1.F1_DTDIGIT >= '" + cDesde + "' " + ;
         "AND SF1.F1_ESPECIE LIKE 'CT%' "
      jResp["ctesPorMes"] := DiagLinhas("ctesPorMes", ;
         "SELECT SUBSTR(SF1.F1_DTDIGIT, 1, 6) AS MES, SF1.F1_ESPECIE AS ESPECIE, SF1.F1_TIPO AS TIPO, " + cChave + " AS TEM_CHAVE, " + ;
         "COUNT(*) AS CTES, SUM(SF1.F1_VALBRUT) AS VALOR FROM " + cSF1 + " SF1" + cCteF + ;
         "GROUP BY SUBSTR(SF1.F1_DTDIGIT, 1, 6), SF1.F1_ESPECIE, SF1.F1_TIPO, " + cChave + " ORDER BY 1, 2", aErros)
      jResp["ctesPorTransportadora"] := DiagLinhas("ctesPorTransportadora", ;
         "SELECT * FROM (SELECT SF1.F1_FORNECE AS FORNECEDOR, SF1.F1_LOJA AS LOJA, MAX(SA2.A2_NOME) AS NOME, " + ;
         "MAX(SA2.A2_CGC) AS CNPJ, COUNT(*) AS CTES, SUM(SF1.F1_VALBRUT) AS VALOR FROM " + cSF1 + " SF1 " + ;
         "LEFT JOIN " + cSA2 + " SA2 ON SA2.A2_FILIAL = '" + cFA2 + "' AND SA2.A2_COD = SF1.F1_FORNECE " + ;
         "AND SA2.A2_LOJA = SF1.F1_LOJA AND SA2.D_E_L_E_T_ = ' '" + cCteF + ;
         "GROUP BY SF1.F1_FORNECE, SF1.F1_LOJA ORDER BY 5 DESC) WHERE ROWNUM <= 25", aErros)
      jResp["ctesTesCfop"] := DiagLinhas("ctesTesCfop", ;
         "SELECT SD1.D1_TES AS TES, SD1.D1_CF AS CFOP, SF4.F4_TEXTO AS TEXTO, COUNT(*) AS ITENS, SUM(SD1.D1_TOTAL) AS VALOR" + ;
         cRetJ + " WHERE SD1.D1_FILIAL = '" + cFD1 + "' AND SD1.D_E_L_E_T_ = ' ' AND SD1.D1_DTDIGIT >= '" + cDesde + "' " + ;
         "AND SF1.F1_ESPECIE LIKE 'CT%' GROUP BY SD1.D1_TES, SD1.D1_CF, SF4.F4_TEXTO ORDER BY 4 DESC", aErros)
      jResp["ctesRecentes"] := DiagLinhas("ctesRecentes", ;
         "SELECT * FROM (SELECT SF1.F1_DOC AS DOC, SF1.F1_SERIE AS SERIE, SF1.F1_FORNECE AS FORNECEDOR, SA2.A2_NOME AS NOME, " + ;
         "SF1.F1_EMISSAO AS EMISSAO, SF1.F1_DTDIGIT AS DIGITACAO, SF1.F1_ESPECIE AS ESPECIE, SF1.F1_VALBRUT AS VALOR, " + ;
         cChave + " AS TEM_CHAVE FROM " + cSF1 + " SF1 LEFT JOIN " + cSA2 + " SA2 ON SA2.A2_FILIAL = '" + cFA2 + "' " + ;
         "AND SA2.A2_COD = SF1.F1_FORNECE AND SA2.A2_LOJA = SF1.F1_LOJA AND SA2.D_E_L_E_T_ = ' '" + cCteF + ;
         "ORDER BY SF1.F1_DTDIGIT DESC, SF1.F1_DOC DESC) WHERE ROWNUM <= 15", aErros)
      If TemTab("ZLC")
         // CTE da ZLC x CTE lancado no fiscal pelo numero sem zeros (todas as
         // datas do fiscal; mesmo numero de transportadoras diferentes = 1 linha)
         jResp["ctesXZlc"] := DiagLinhas("ctesXZlc", ;
            "SELECT COUNT(*) AS LINHAS_ZLC, " + ;
            "SUM(CASE WHEN F.DOCN IS NOT NULL THEN 1 ELSE 0 END) AS ACHADOS_NO_FISCAL, " + ;
            "SUM(CASE WHEN F.DOCN IS NOT NULL AND F.QTD > 1 THEN 1 ELSE 0 END) AS NUMERO_REPETIDO_NO_FISCAL, " + ;
            "SUM(CASE WHEN F.DOCN IS NOT NULL AND ABS(F.VALOR - Z.ZLC_VALOR) < 0.01 THEN 1 ELSE 0 END) AS MESMO_VALOR, " + ;
            "MIN(Z.ZLC_DATA) AS PRIMEIRA, MAX(Z.ZLC_DATA) AS ULTIMA " + ;
            "FROM " + RetSqlName("ZLC") + " Z LEFT JOIN (SELECT LTRIM(SF1.F1_DOC, '0') AS DOCN, MAX(SF1.F1_VALBRUT) AS VALOR, " + ;
            "COUNT(*) AS QTD FROM " + cSF1 + " SF1 WHERE SF1.F1_FILIAL = '" + cFF1 + "' AND SF1.D_E_L_E_T_ = ' ' " + ;
            "AND SF1.F1_ESPECIE LIKE 'CT%' GROUP BY LTRIM(SF1.F1_DOC, '0')) F ON F.DOCN = LTRIM(TRIM(Z.ZLC_CTE), '0') " + ;
            "WHERE Z.ZLC_FILIAL = '" + FWxFilial("ZLC") + "' AND Z.D_E_L_E_T_ = ' ' " + ;
            "AND Z.ZLC_CTE <> ' ' AND Z.ZLC_CTE <> 'SEM CTE'", aErros)
      EndIf

      // ---------- XML guardado? (tabelas do importador/colaboracao) ----------
      aXml := {"CKO", "SDS", "SDT", "C00", "NNR"}
      For nI := 1 to Len(aXml)
         cTabs += IIf(nI > 1, ",", "") + "'" + aXml[nI] + cSuf + "'"
      Next nI
      aAchou := DiagLinhas("tabelasXml", "SELECT TABLE_NAME FROM ALL_TABLES WHERE " + LG_OWNER + ;
         " AND TABLE_NAME IN (" + cTabs + ") ORDER BY 1", aErros)
      jResp["tabelasXml"] := {}
      For nI := 1 to Len(aAchou)
         jXml := JsonObject():New()
         jXml["tabela"] := aAchou[nI]["TABLE_NAME"]
         jXml["linhas"] := DiagLinhas("linhas " + jXml["tabela"], "SELECT COUNT(*) AS QTD FROM " + jXml["tabela"], aErros)
         jXml["colunas"] := DiagLinhas("colunas " + jXml["tabela"], "SELECT COLUMN_NAME, DATA_TYPE FROM ALL_TAB_COLUMNS WHERE " + ;
            LG_OWNER + " AND TABLE_NAME = '" + jXml["tabela"] + "' ORDER BY COLUMN_ID", aErros)
         aAdd(jResp["tabelasXml"], jXml)
         If jXml["tabela"] == "NNR" + cSuf
            jResp["armazens"] := DiagLinhas("armazens", ;
               "SELECT SD1.D1_LOCAL AS ARMAZEM, MAX(NNR.NNR_DESCRI) AS DESCRICAO, COUNT(*) AS ITENS" + cRetJ + ;
               "LEFT JOIN " + RetSqlName("NNR") + " NNR ON NNR.NNR_FILIAL = '" + FWxFilial("NNR") + "' " + ;
               "AND NNR.NNR_CODIGO = SD1.D1_LOCAL AND NNR.D_E_L_E_T_ = ' '" + cRetF + "GROUP BY SD1.D1_LOCAL ORDER BY 1", aErros)
         EndIf
      Next nI

      jResp["tabelasZ"] := DiagLinhas("tabelasZ", "SELECT TABLE_NAME FROM ALL_TABLES WHERE " + LG_OWNER + ;
         " AND TABLE_NAME LIKE 'Z%' ORDER BY 1", aErros)

      jResp["erros"] := aErros
      jRet := oRest:setStatusResponse(200, jResp:ToJson())

   Recover Using oErr
      If ValType(oErr) == "O"
         jRet := BuildErro(500, "ERRO_DIAGNOSTICO", TxtErro(oErr))
      EndIf
   End Sequence
   ErrorBlock(bErrOld)
   If jRet == Nil
      jRet := BuildErro(500, "ERRO_DIAGNOSTICO", "Erro inesperado.")
   EndIf
Return jRet

// "C1, C2" com as colunas da lista que nao estao em cExist ("|A|B|...")
Static Function Faltam(cExist, aCols)
   Local cRet := ""
   Local nI   := 0
   For nI := 1 to Len(aCols)
      If !(("|" + aCols[nI] + "|") $ cExist)
         cRet += aCols[nI] + " "
      EndIf
   Next nI
Return cRet

// Roda a consulta e devolve as linhas como {COLUNA: valor} (ate 5000). Erro vai
// para aErros, o cursor e fechado e volta {} (as outras secoes seguem).
Static Function DiagLinhas(cNome, cQuery, aErros)
   Local aRet   := {}
   Local cAl    := GetNextAlias()
   Local oStmt  := Nil
   Local jL     := Nil
   Local nI     := 0
   Local xV     := Nil
   Local bErrAn := ErrorBlock({|oE| Break(oE) })
   Local oErr   := Nil
   Begin Sequence
      oStmt := FWExecStatement():New(cQuery)
      cAl := oStmt:OpenAlias(cAl)
      If Empty(cAl) .or. Select(cAl) == 0
         aAdd(aErros, cNome + ": consulta nao abriu")
         Break
      EndIf
      Do While !(cAl)->(Eof()) .and. Len(aRet) < 5000
         jL := JsonObject():New()
         For nI := 1 to (cAl)->(FCount())
            xV := (cAl)->(FieldGet(nI))
            If ValType(xV) == "C"
               jL[(cAl)->(FieldName(nI))] := TxtOut(Left(xV, 500))
            ElseIf ValType(xV) == "N" .or. ValType(xV) == "L"
               jL[(cAl)->(FieldName(nI))] := xV
            ElseIf ValType(xV) == "D"
               jL[(cAl)->(FieldName(nI))] := DToS(xV)
            Else
               jL[(cAl)->(FieldName(nI))] := ""
            EndIf
         Next nI
         aAdd(aRet, jL)
         (cAl)->(DbSkip())
      EndDo
      (cAl)->(DbCloseArea())
      oStmt:Destroy()
   Recover Using oErr
      If ValType(cAl) == "C" .and. Select(cAl) > 0
         (cAl)->(DbCloseArea())
      EndIf
      If ValType(oErr) == "O"
         aAdd(aErros, cNome + ": " + Left(TxtErro(oErr), 300))
      EndIf
   End Sequence
   ErrorBlock(bErrAn)
Return aRet

Static Function BuildErro(nStatus, cCod, cMsg)
   Local jE := JsonObject():New()
   jE["error"] := JsonObject():New()
   jE["error"]["code"]    := cCod
   jE["error"]["message"] := cMsg
   // corpo de status >= 500 e descartado pelo framework: a mensagem vai no header
   oRest:setKeyHeaderResponse("X-Erro", cMsg)
   // a tela roda em outra porta (CORS): sem isso o navegador esconde o X-Erro
   oRest:setKeyHeaderResponse("Access-Control-Expose-Headers", "X-Erro, X-Erro-Etapa")
Return oRest:setStatusResponse(nStatus, jE:ToJson())

// sem Begin Sequence aqui dentro: e chamada no Recover
Static Function TxtErro(oErr)
   If ValType(oErr) == "O"
      Return AllTrim(SStr(oErr:Description))
   EndIf
Return "erro sem descricao"

Static Function SStr(xV)
   If ValType(xV) == "C"
      Return xV
   EndIf
Return ""

Static Function NNum(xV)
   If ValType(xV) == "N"
      Return xV
   ElseIf ValType(xV) == "C" .and. !Empty(xV)
      Return ValTxt(xV)
   EndIf
Return 0

Static Function IsoOut(xV)
   Local c := ""
   If ValType(xV) == "D"
      c := DToS(xV)
   Else
      c := AllTrim(SStr(xV))
   EndIf
   If Len(c) != 8
      Return ""
   EndIf
Return SubStr(c, 1, 4) + "-" + SubStr(c, 5, 2) + "-" + SubStr(c, 7, 2)

Static Function TxtOut(xV)
   Local cV := ""
   If ValType(xV) != "C"
      Return ""
   EndIf
   cV := AllTrim(xV)
   If Empty(cV)
      Return ""
   EndIf
Return EncodeUTF8(cV)
